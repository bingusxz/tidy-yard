<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>TidyYard</AssemblyName>
    <RootNamespace>TidyYard</RootNamespace>
    <Product>Tidy Yard</Product>
    <AssemblyTitle>Tidy Yard</AssemblyTitle>
    <!-- Exe, taskbar, Alt-Tab and window icon. -->
    <ApplicationIcon>Assets\Logo\TidyYard.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main runs Velopack's install/update hooks before WPF starts. -->
    <StartupObject>TidyYard.Program</StartupObject>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Ical.Net" Version="5.2.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <!-- OFL fonts compiled into the assembly as WPF resources. -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <None Include="Assets\Fonts\*-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
