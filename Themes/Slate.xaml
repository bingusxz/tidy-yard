<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Slate: cool blue-grey, soft white text, sky accent.
         Every text colour is at least 4.5:1 (WCAG AA) on the glass at full background opacity. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TidyYard;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Brush.Window" Color="#1A2029" />
    <SolidColorBrush x:Key="Brush.Glass" Color="#1A2029" />

    <SolidColorBrush x:Key="Brush.Card" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Brush.Raised" Color="#2B3442" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Brush.Input" Color="#4D000000" />
    <SolidColorBrush x:Key="Brush.Rule" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Brush.RuleStrong" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="Brush.Text" Color="#E4E9F0" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#D2D7DF" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#BCC4CE" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#7FB0E8" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#337FB0E8" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#0C1624" />


    <!-- Readable foreground colours are separate from filled accent surfaces. -->
    <SolidColorBrush x:Key="Brush.AccentText" Color="#A4C7EF" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFB0AB" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#F1C65C" />

</ResourceDictionary>