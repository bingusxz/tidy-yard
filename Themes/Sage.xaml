<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Sage: soft green paper, ink text, deep green accent.
         Every text colour is at least 4.5:1 (WCAG AA) on the glass at full background opacity. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TidyYard;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Brush.Window" Color="#E8EDE3" />
    <SolidColorBrush x:Key="Brush.Glass" Color="#E8EDE3" />

    <SolidColorBrush x:Key="Brush.Card" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="Brush.Raised" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#12000000" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#21000000" />
    <SolidColorBrush x:Key="Brush.Input" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="Brush.Rule" Color="#1A000000" />
    <SolidColorBrush x:Key="Brush.RuleStrong" Color="#33000000" />
    <SolidColorBrush x:Key="Brush.Text" Color="#1D241C" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#444D40" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#50594B" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#2F6B45" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#262F6B45" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#F3F8F1" />


    <!-- Readable foreground colours are separate from filled accent surfaces. -->
    <SolidColorBrush x:Key="Brush.AccentText" Color="#2B613F" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#9E2B35" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#754E00" />

</ResourceDictionary>