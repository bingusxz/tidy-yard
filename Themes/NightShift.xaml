<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Night Shift: near-black glass, amber accent.
         Text roles are checked against opaque theme surfaces and interactive overlays. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TidyYard;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Brush.Window" Color="#141413" />
    <SolidColorBrush x:Key="Brush.Glass" Color="#141413" />

    <SolidColorBrush x:Key="Brush.Card" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Brush.Raised" Color="#2E2D29" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Brush.Input" Color="#4D000000" />
    <SolidColorBrush x:Key="Brush.Rule" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Brush.RuleStrong" Color="#2EFFFFFF" />

    <SolidColorBrush x:Key="Brush.Text" Color="#EDE8DC" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#D1CEC6" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#D1CEC6" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#E0A44A" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#33E0A44A" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#17130C" />


    <!-- Readable foreground colours are separate from filled accent surfaces. -->
    <SolidColorBrush x:Key="Brush.AccentText" Color="#E5B367" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFB0AB" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#F1C65C" />

</ResourceDictionary>
