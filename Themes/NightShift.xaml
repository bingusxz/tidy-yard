<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Night Shift: near-black, low-contrast rules, amber accent.
         Contrast (WCAG): Text 13.9:1, Muted 7.5:1, Dim 5.7:1 on Window; lowest pair Dim on Hover 4.9:1;
         OnAccent on Accent 8.0:1. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TidyYard;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Brush.Window" Color="#141413" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#1A1A18" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#22221F" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#2A2A27" />
    <SolidColorBrush x:Key="Brush.Input" Color="#0F0F0E" />
    <SolidColorBrush x:Key="Brush.Rule" Color="#2A2A27" />
    <SolidColorBrush x:Key="Brush.RuleStrong" Color="#3D3D38" />
    <SolidColorBrush x:Key="Brush.Text" Color="#E4DFD3" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#ABA597" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#938E82" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#D9A04A" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#141413" />

</ResourceDictionary>
