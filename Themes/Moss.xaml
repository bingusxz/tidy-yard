<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Moss: deep green, cream text, brass accent.
         Contrast (WCAG): Text 11.3:1, Muted 7.7:1, Dim 5.9:1 on Window; lowest pair Dim on Hover 5.0:1;
         OnAccent on Accent 6.0:1. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TidyYard;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Brush.Window" Color="#1E3226" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#22382B" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#263E30" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#2C4637" />
    <SolidColorBrush x:Key="Brush.Input" Color="#192B20" />
    <SolidColorBrush x:Key="Brush.Rule" Color="#355140" />
    <SolidColorBrush x:Key="Brush.RuleStrong" Color="#4A6855" />
    <SolidColorBrush x:Key="Brush.Text" Color="#F0E9D6" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#C9C2AC" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#AFAB98" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#C29E55" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#1A2A20" />

</ResourceDictionary>
