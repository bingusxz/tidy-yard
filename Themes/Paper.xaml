<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paper: warm off-white, ink text, muted green accent.
         Contrast (WCAG): Text 14.2:1, Muted 6.8:1, Dim 5.6:1 on Window; lowest pair Dim on Hover 5.0:1;
         OnAccent on Accent 5.7:1. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TidyYard;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Brush.Window" Color="#F3EFE6" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#EAE5D9" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#E8E3D7" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#DFD9CB" />
    <SolidColorBrush x:Key="Brush.Input" Color="#FAF8F3" />
    <SolidColorBrush x:Key="Brush.Rule" Color="#D3CCBC" />
    <SolidColorBrush x:Key="Brush.RuleStrong" Color="#B3AB99" />
    <SolidColorBrush x:Key="Brush.Text" Color="#22201C" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#57524A" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#645E54" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#3E6A4B" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#F7F4EC" />

</ResourceDictionary>
