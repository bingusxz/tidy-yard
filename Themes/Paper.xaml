<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paper: warm off-white glass, ink text, green accent.
         Text roles are checked against opaque theme surfaces and interactive overlays. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TidyYard;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Solid fill: the glass tint, and the whole background where acrylic is unavailable. -->
    <SolidColorBrush x:Key="Brush.Window" Color="#F3EFE6" />
    <SolidColorBrush x:Key="Brush.Glass" Color="#F3EFE6" />

    <!-- Layers on top of the glass (semi-transparent so the blur shows through). -->
    <SolidColorBrush x:Key="Brush.Card" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="Brush.Raised" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#12000000" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#21000000" />
    <SolidColorBrush x:Key="Brush.Input" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="Brush.Rule" Color="#1A000000" />
    <SolidColorBrush x:Key="Brush.RuleStrong" Color="#33000000" />

    <SolidColorBrush x:Key="Brush.Text" Color="#1E1C19" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#514C45" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#514C45" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#3E6A4B" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#263E6A4B" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#F7F4EC" />


    <!-- Readable foreground colours are separate from filled accent surfaces. -->
    <SolidColorBrush x:Key="Brush.AccentText" Color="#386044" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#A32D36" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#795100" />

</ResourceDictionary>
