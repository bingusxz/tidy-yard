<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Inter (OFL) for everything, compiled in as a resource. Shared by every theme.
         Numbers use tabular figures (set on Style.Window) so times and dates line up. -->
    <FontFamily x:Key="Font.Heading">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="Font.UI">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="Font.Numbers">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- The whole type scale. Four sizes, nothing else. -->
    <sys:Double x:Key="Size.Small">11</sys:Double>
    <sys:Double x:Key="Size.Body">13</sys:Double>
    <sys:Double x:Key="Size.Title">18</sys:Double>
    <sys:Double x:Key="Size.Display">56</sys:Double>

    <sys:Double x:Key="Size.EditorDate">28</sys:Double>
    <sys:Double x:Key="Size.MonthBadge">26</sys:Double>
    <sys:Double x:Key="Size.MonthHeader">32</sys:Double>
    <sys:Double x:Key="Size.MonthEventLine">20</sys:Double>

    <!-- Icon glyph size (Segoe Fluent Icons), not part of the type scale. -->
    <sys:Double x:Key="Size.Icon">14</sys:Double>

    <!-- Icon glyphs, single stroke weight. -->
    <sys:String x:Key="Glyph.ChevronLeft">&#xE76B;</sys:String>
    <sys:String x:Key="Glyph.ChevronRight">&#xE76C;</sys:String>
    <sys:String x:Key="Glyph.Settings">&#xE713;</sys:String>
    <sys:String x:Key="Glyph.Close">&#xE711;</sys:String>
    <sys:String x:Key="Glyph.Add">&#xE710;</sys:String>
    <sys:String x:Key="Glyph.Lock">&#xE72E;</sys:String>
    <sys:String x:Key="Glyph.Unlock">&#xE785;</sys:String>
    <sys:String x:Key="Glyph.Hide">&#xE921;</sys:String>
    <sys:String x:Key="Glyph.ChevronUp">&#xE70E;</sys:String>
    <sys:String x:Key="Glyph.ChevronDown">&#xE70D;</sys:String>
    <sys:String x:Key="Glyph.More">&#xE712;</sys:String>
    <sys:String x:Key="Glyph.Check">&#xE73E;</sys:String>
    <sys:String x:Key="Glyph.Search">&#xE721;</sys:String>

</ResourceDictionary>
