<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Ink: warm charcoal, cream text, sage accent.
         Every text colour is at least 4.5:1 (WCAG AA) on the glass at full background opacity. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TidyYard;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Brush.Window" Color="#22201D" />
    <SolidColorBrush x:Key="Brush.Glass" Color="#22201D" />

    <SolidColorBrush x:Key="Brush.Card" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Brush.Raised" Color="#34312D" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Brush.Input" Color="#4D000000" />
    <SolidColorBrush x:Key="Brush.Rule" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Brush.RuleStrong" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="Brush.Text" Color="#ECE6DA" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#B3AC9E" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#A09A8D" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#8FB8A0" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#338FB8A0" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#10201A" />

</ResourceDictionary>