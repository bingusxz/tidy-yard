<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Linen: warm greige glass, ink text, terracotta accent.
         Every text colour is at least 4.5:1 (WCAG AA) on the glass at full background opacity. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TidyYard;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Brush.Window" Color="#ECE7DF" />
    <SolidColorBrush x:Key="Brush.Glass" Color="#ECE7DF" />

    <SolidColorBrush x:Key="Brush.Card" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="Brush.Raised" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#12000000" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#21000000" />
    <SolidColorBrush x:Key="Brush.Input" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="Brush.Rule" Color="#1A000000" />
    <SolidColorBrush x:Key="Brush.RuleStrong" Color="#33000000" />
    <SolidColorBrush x:Key="Brush.Text" Color="#24211D" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#4C4740" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#59534A" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#9A4527" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#269A4527" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FBF5EE" />


    <!-- Readable foreground colours are separate from filled accent surfaces. -->
    <SolidColorBrush x:Key="Brush.AccentText" Color="#893D23" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#9B2A34" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#734D00" />

</ResourceDictionary>