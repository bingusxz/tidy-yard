<Window x:Class="TidyYard.Views.MiniCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TidyYard.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MiniCalendarViewModel}"
        Title="Tidy Yard"
        Style="{DynamicResource Style.Window}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Width="300" Height="440"
        MinWidth="240" MinHeight="360"
        ShowInTaskbar="False">

    <!-- No caption: the window is dragged from any empty part of it (see the code-behind), resized from the edges. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid MouseLeftButtonDown="OnBackgroundMouseDown">
        <Border Background="{DynamicResource Brush.HitArea}" CornerRadius="12" />
        <Border Background="{DynamicResource Brush.Glass}" Opacity="{Binding GlassOpacity}" CornerRadius="12" />
        <Border Background="{DynamicResource Brush.Scrim}" CornerRadius="12" IsHitTestVisible="False" />

        <Grid Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Date: opens the calendar on today. -->
            <Button Grid.Row="0"
                    HorizontalAlignment="Left"
                    Padding="4,2,12,2"
                    Margin="-4,0,0,0"
                    Style="{DynamicResource Button.Bare}"
                    Command="{Binding OpenTodayCommand}"
                    ToolTip="Open the calendar on today"
                    AutomationProperties.Name="Open the calendar on today">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Style="{DynamicResource Text.Display}" Text="{Binding DayNumber}" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource Text.Title}" Text="{Binding WeekdayText}" />
                        <TextBlock Margin="0,2,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding MonthYearText}" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- Lock and hide show only while the pointer is over the widget. -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="IsHitTestVisible" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Width="28" Height="28"
                        Command="{Binding ToggleLockCommand}"
                        ToolTip="{Binding LockToolTip}"
                        AutomationProperties.Name="{Binding LockToolTip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                            <Setter Property="Content" Value="{DynamicResource Glyph.Unlock}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                    <Setter Property="Content" Value="{DynamicResource Glyph.Lock}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{DynamicResource Button.Icon}"
                        Width="28" Height="28"
                        Content="{DynamicResource Glyph.Close}"
                        Command="{Binding HideCommand}"
                        ToolTip="Hide the mini calendar"
                        AutomationProperties.Name="Hide the mini calendar" />
            </StackPanel>

            <!-- Today's agenda: time column, then the title. -->
            <Grid Grid.Row="1" Margin="0,16,0,12">
                <TextBlock VerticalAlignment="Top" Style="{DynamicResource Text.Muted}" Text="Nothing scheduled">
                    <TextBlock.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAgenda}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Resources>
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Agenda}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EventItemViewModel}">
                                <Button Padding="0,4"
                                        Style="{DynamicResource Button.Bare}"
                                        Command="{Binding DataContext.OpenTodayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Top" FontSize="{DynamicResource Size.Small}" Foreground="{DynamicResource Brush.TextMuted}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding TimeText}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasTime}" Value="False">
                                                            <Setter Property="Text" Value="All day" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" FontWeight="Medium" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Month: title and arrows, weekday letters, then the days. -->
            <StackPanel Grid.Row="2">
                <Border Height="1" Margin="0,0,0,8" Background="{DynamicResource Brush.Rule}" />
                <Grid>
                    <Button HorizontalAlignment="Left"
                            Padding="4,4"
                            Margin="-4,0,0,0"
                            Style="{DynamicResource Button.Bare}"
                            Command="{Binding ThisMonthCommand}"
                            ToolTip="Back to this month"
                            AutomationProperties.Name="Back to this month">
                        <TextBlock FontWeight="SemiBold" Text="{Binding MonthTitle}" />
                    </Button>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{DynamicResource Button.Icon}"
                                Width="28" Height="28"
                                Content="{DynamicResource Glyph.ChevronLeft}"
                                Command="{Binding PreviousMonthCommand}"
                                ToolTip="Previous month"
                                AutomationProperties.Name="Previous month" />
                        <Button Style="{DynamicResource Button.Icon}"
                                Width="28" Height="28"
                                Content="{DynamicResource Glyph.ChevronRight}"
                                Command="{Binding NextMonthCommand}"
                                ToolTip="Next month"
                                AutomationProperties.Name="Next month" />
                    </StackPanel>
                </Grid>

                <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding WeekdayNames}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="10,0,0,4" Style="{DynamicResource Text.Label}" Foreground="{DynamicResource Brush.TextDim}" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding MonthDays}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DayCellViewModel}">
                            <Button Height="36"
                                    Style="{DynamicResource Button.Bare}"
                                    Command="{Binding SelectCommand}"
                                    AutomationProperties.Name="{Binding AccessibleName}">
                                <Grid Margin="4,2,0,0">
                                    <Border x:Name="Mark" HorizontalAlignment="Left" VerticalAlignment="Top"
                                            MinWidth="26" Height="26" Padding="6,0" CornerRadius="13">
                                        <TextBlock x:Name="Number"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Brush.Text}"
                                                   Text="{Binding DayNumber}" />
                                    </Border>
                                    <Ellipse x:Name="EventDot" Width="4" Height="4" Margin="11,0,0,0"
                                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                             Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasEvents}" Value="True">
                                    <Setter TargetName="EventDot" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsInMonth}" Value="False">
                                    <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                    <Setter TargetName="Number" Property="FontWeight" Value="Normal" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter TargetName="Mark" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                    <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                    <Setter TargetName="Number" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
