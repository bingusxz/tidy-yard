<Window x:Class="TidyYard.Views.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TidyYard.ViewModels"
        xmlns:views="clr-namespace:TidyYard.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CalendarViewModel}"
        Title="Tidy Yard"
        Style="{DynamicResource Style.Window}"
        WindowStyle="None"
        ResizeMode="CanResize"
        Width="900" Height="540"
        ShowInTaskbar="False"
        MinWidth="640" MinHeight="420">

    <!-- Drag by the top strip, resize from the edges. Swapped in code when the widget is locked. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="Left" Command="{Binding PreviousCommand}" />
        <KeyBinding Modifiers="Control" Key="Right" Command="{Binding NextCommand}" />
        <KeyBinding Modifiers="Control" Key="T" Command="{Binding GoToTodayCommand}" />
        <KeyBinding Modifiers="Control" Key="F" Command="{Binding OpenSearchCommand}" />
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding ShowViewCommand}" CommandParameter="Month" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding ShowViewCommand}" CommandParameter="Week" />
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding ShowViewCommand}" CommandParameter="Day" />
    </Window.InputBindings>

    <Grid>
        <Border Background="{DynamicResource Brush.HitArea}" CornerRadius="12" />
        <!-- True alpha tint throughout the opacity range; controls share calendar-local brushes. -->
        <Border Background="{DynamicResource Brush.Glass}" Opacity="{Binding GlassOpacity}" CornerRadius="12" />

        <Grid x:Name="CalendarContent" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CardColumn" Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Day card: big date, quick add, agenda / editor ============ -->
            <Border x:Name="DayCard" Grid.Column="0" Background="Transparent" CornerRadius="12">
                <Grid>
                <Border Background="{DynamicResource Brush.Card}" CornerRadius="12" IsHitTestVisible="False" />
                <DockPanel x:Name="DayCardContent" Margin="20,16" DataContext="{Binding Editor}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource Text.Label}" Text="{Binding WeekdayText}" />
                        <TextBlock Margin="8,0,0,0"
                                   Style="{DynamicResource Text.Label}"
                                   Foreground="{DynamicResource Brush.AccentText}"
                                   Text="{Binding RelativeText}"
                                   Visibility="{Binding HasRelativeText, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,4,0,0" Text="{Binding DayNumberText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Display}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFormOpen}" Value="True">
                                        <Setter Property="FontSize" Value="{DynamicResource Size.EditorDate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding MonthYearText}" />

                    <TextBox DockPanel.Dock="Top"
                             Margin="0,16,0,0"
                             Tag="{Binding QuickAddHint}"
                             Text="{Binding QuickAddText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Quick add">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding QuickAddCommand}" />
                        </TextBox.InputBindings>
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource TextBox.QuickAdd}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFormOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- After a delete or a skip: one click to take it back. Goes away after a few seconds. -->
                    <Border DockPanel.Dock="Top"
                            Margin="0,12,0,0"
                            Padding="12,4,4,4"
                            CornerRadius="8"
                            Background="{DynamicResource Brush.Surface}"
                            Visibility="{Binding HasUndo, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{DynamicResource Button.Text}"
                                    Content="Undo"
                                    Command="{Binding UndoCommand}" />
                            <TextBlock VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding UndoText}" />
                        </DockPanel>
                    </Border>


                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Agenda for the selected day -->
                        <Grid Grid.Row="0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFormOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <TextBlock Margin="4,4,0,0" Text="Nothing scheduled">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasEvents}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer Margin="-8,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl ItemsSource="{Binding Events}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:EventItemViewModel}">
                                            <StackPanel>
                                            <Button Style="{DynamicResource Button.Bare}"
                                                    Padding="8"
                                                    PreviewMouseLeftButtonDown="OnEventPress"
                                                    PreviewMouseLeftButtonUp="OnEventRelease"
                                                    PreviewMouseMove="OnEventMove"
                                                    IsEnabled="{Binding IsEditable}"
                                                    ToolTip="{Binding SourceText}"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Title}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Margin="0,1,0,0"
                                                               FontSize="{DynamicResource Size.Small}"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource Brush.TextMuted}"
                                                               Text="{Binding AgendaTime}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontWeight="Medium" TextWrapping="Wrap">
                                                            <Run Text="{Binding Title, Mode=OneWay}" /><Run Foreground="{DynamicResource Brush.TextDim}" Text="{Binding ProgressText, Mode=OneWay, StringFormat=' {0}'}" />
                                                        </TextBlock>
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Style="{DynamicResource Text.Muted}"
                                                                   Text="{Binding Note}"
                                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="{DynamicResource Size.Small}"
                                                                   Foreground="{DynamicResource Brush.TextDim}"
                                                                   Text="{Binding SourceText}"
                                                                   Visibility="{Binding IsImported, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="{DynamicResource Size.Small}"
                                                                   Foreground="{DynamicResource Brush.TextDim}"
                                                                   Text="{Binding RepeatText}"
                                                                   Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="{DynamicResource Size.Small}"
                                                                   Foreground="{DynamicResource Brush.TextDim}"
                                                                   Text="{Binding SpanText}"
                                                                   Visibility="{Binding HasSpanText, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <!-- Checklist: ticking saves straight away. -->
                                            <ItemsControl Margin="72,0,0,8" ItemsSource="{Binding Checklist}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ChecklistItemViewModel}">
                                                        <CheckBox Style="{DynamicResource CheckBox.Tick}" IsChecked="{Binding IsDone}">
                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Lower section: always there, whatever day is selected. Reminders across all days, or standalone lists. -->
                        <DockPanel Grid.Row="1" Margin="0,12,0,0">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFormOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <Border DockPanel.Dock="Top" Height="1" Margin="0,0,0,12" Background="{DynamicResource Brush.Rule}" />
                            <ListBox DockPanel.Dock="Top"
                                     Margin="0,0,0,8"
                                     HorizontalAlignment="Stretch"
                                     Style="{DynamicResource ListBox.Segmented}"
                                     ItemsSource="{Binding DataContext.CardTabs, RelativeSource={RelativeSource AncestorType=Window}}"
                                     SelectedItem="{Binding DataContext.SelectedCardTab, RelativeSource={RelativeSource AncestorType=Window}}"
                                     AutomationProperties.Name="Lower section">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center" FontSize="{DynamicResource Size.Small}" Text="{Binding}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid>
                        <!-- Reminders: everything coming up, across all days. -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DataContext.IsRemindersTab, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                <Condition Binding="{Binding IsFormOpen}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <TextBlock Margin="4,4,0,0" Text="Nothing scheduled">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.Reminders.HasLines, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer Margin="-8,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl ItemsSource="{Binding DataContext.Reminders.Lines, RelativeSource={RelativeSource AncestorType=Window}}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ReminderLineViewModel}">
                                            <Button Style="{DynamicResource Button.Bare}"
                                                    Padding="8"
                                                    Command="{Binding DataContext.OpenEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Item}"
                                                    AutomationProperties.Name="{Binding Title}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="Medium" TextWrapping="Wrap" Text="{Binding Title}" />
                                                    <TextBlock Margin="0,2,0,0" FontSize="{DynamicResource Size.Small}" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding WhenText}" />
                                                    <TextBlock Margin="0,2,0,0" FontSize="{DynamicResource Size.Small}" Foreground="{DynamicResource Brush.TextDim}" Text="{Binding LeadText}" />
                                                    <TextBlock Margin="0,2,0,0" FontSize="{DynamicResource Size.Small}" Foreground="{DynamicResource Brush.TextDim}"
                                                               Text="{Binding RepeatText}"
                                                               Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Lists: standalone checklists. Ticking saves straight away; the name edits in place. -->
                        <DockPanel>
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DataContext.IsListsTab, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                <Condition Binding="{Binding IsFormOpen}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>

                            <TextBox DockPanel.Dock="Top"
                                     Tag="New list, like Groceries"
                                     Text="{Binding DataContext.Lists.NewListTitle, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="New list">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding DataContext.Lists.AddListCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <ScrollViewer Margin="-8,4,-8,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl ItemsSource="{Binding DataContext.Lists.Lists, RelativeSource={RelativeSource AncestorType=Window}}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TodoListViewModel}">
                                            <StackPanel Margin="8,12,8,0">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right"
                                                            Style="{DynamicResource Button.Text}"
                                                            Content="{Binding DeleteLabel}"
                                                            Command="{Binding DeleteCommand}" />
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Margin="8,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="{DynamicResource Size.Small}"
                                                               Foreground="{DynamicResource Brush.TextMuted}"
                                                               Text="{Binding ProgressText}" />
                                                    <TextBox Style="{DynamicResource TextBox.Inline}"
                                                             VerticalAlignment="Center"
                                                             FontWeight="SemiBold"
                                                             Text="{Binding Title, UpdateSourceTrigger=LostFocus}"
                                                             AutomationProperties.Name="List name" />
                                                </DockPanel>

                                                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Items}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:TodoItemViewModel}">
                                                            <DockPanel Margin="0,0,0,2">
                                                                <Button DockPanel.Dock="Right"
                                                                        Width="24" Height="24"
                                                                        Style="{DynamicResource Button.Icon}"
                                                                        Content="{DynamicResource Glyph.Close}"
                                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Remove"
                                                                        AutomationProperties.Name="Remove item" />
                                                                <CheckBox Style="{DynamicResource CheckBox.Tick}" IsChecked="{Binding IsDone}">
                                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </CheckBox>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBox Margin="0,6,0,0"
                                                         Tag="Add an item"
                                                         Text="{Binding NewItemText, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Add an item">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Enter" Command="{Binding AddItemCommand}" />
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                                <Border Height="1" Margin="0,12,0,0" Background="{DynamicResource Brush.Rule}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                            </Grid>
                        </DockPanel>

                        <!-- Add / edit form -->
                        <DockPanel Grid.RowSpan="2" Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibility}}">
                            <Border DockPanel.Dock="Bottom" Padding="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Rule}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,6" Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                    <WrapPanel>
                                        <Button Margin="0,0,6,4" Style="{DynamicResource Button.Primary}" Content="Save" IsDefault="{Binding IsFormOpen}" Command="{Binding SaveCommand}" />
                                        <Button Margin="0,0,0,4" Style="{DynamicResource Button.Text}" Content="Cancel" IsCancel="{Binding IsFormOpen}" Command="{Binding CancelCommand}" />
                                        <Button Margin="4,0,0,4" Width="32" Height="32" Style="{DynamicResource Button.Icon}" Command="{Binding DeleteCommand}" ToolTip="{Binding DeleteText}" AutomationProperties.Name="{Binding DeleteText}" Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}">
                                            <Path Width="14" Height="16" Stretch="Uniform" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,4 L13,4 M6,4 L6,2 L10,2 L10,4 M4,4 L5,15 L11,15 L12,4 M7,7 L7,12 M9,7 L9,12" />
                                        </Button>
                                    </WrapPanel>
                                    <Button HorizontalAlignment="Left" Style="{DynamicResource Button.Text}" Content="Skip this day" Command="{Binding SkipDayCommand}" Visibility="{Binding IsEditingSeries, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Style="{DynamicResource Text.Label}" Text="{Binding FormHeading}" />
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                            </StackPanel>
                        <ScrollViewer x:Name="EventFormScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" HorizontalContentAlignment="Stretch" Padding="0,0,6,10">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.Label}" Text="Title" />
                                <TextBox x:Name="EventTitleBox" Margin="0,4,0,0"
                                         Tag="Title"
                                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Title"
                                         IsVisibleChanged="OnTitleBoxVisibleChanged" />

                                <TextBlock Margin="0,8,0,4" Style="{DynamicResource Text.Label}" Text="Start time" />
                                <views:TimeEntry TimeText="{Binding TimeText, Mode=TwoWay}" Uses24Hour="{Binding Uses24Hour}" AutomationProperties.Name="Start time" />
                                <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding TimeHint}" />

                                <Expander Header="End time and repeat" Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text}" HorizontalContentAlignment="Stretch">
                                    <StackPanel Margin="0,6,0,0">
                                <TextBlock Margin="0,8,0,4" Style="{DynamicResource Text.Label}" Text="End time (optional)" />
                                <views:TimeEntry TimeText="{Binding EndTimeText, Mode=TwoWay}" Uses24Hour="{Binding Uses24Hour}" AutomationProperties.Name="End time" />
                                <TextBox Margin="0,8,0,0"
                                         Tag="End date (optional, for several days)"
                                         Text="{Binding EndDateText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="End date" />
                                <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding DateHint}" />

                                <TextBlock Margin="0,12,0,4" Style="{DynamicResource Text.Muted}" Text="Repeat" />
                                <ComboBox Style="{DynamicResource ComboBox.Flat}"
                                          ItemsSource="{Binding RepeatOptions}"
                                          SelectedItem="{Binding SelectedRepeat}"
                                          DisplayMemberPath="Name"
                                          AutomationProperties.Name="Repeat" />
                                <TextBox Margin="0,8,0,0"
                                         Tag="Repeat until (optional)"
                                         Text="{Binding RepeatUntilText, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding CanRepeatUntil, Converter={StaticResource BoolToVisibility}}"
                                         AutomationProperties.Name="Repeat until" />

                                    </StackPanel>
                                </Expander>
                                <TextBlock Margin="0,12,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                            <Setter Property="Text" Value="Reminder" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanSetReminder}" Value="False">
                                                    <Setter Property="Text" Value="Reminder (add a time first)" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ComboBox Style="{DynamicResource ComboBox.Flat}"
                                          ItemsSource="{Binding ReminderOptions}"
                                          SelectedItem="{Binding SelectedReminder}"
                                          DisplayMemberPath="Name"
                                          IsEnabled="{Binding CanSetReminder}"
                                          AutomationProperties.Name="Reminder" />

                                <Expander Header="Checklist and notes" Margin="0,12,0,0" Foreground="{DynamicResource Brush.Text}" HorizontalContentAlignment="Stretch">
                                    <StackPanel>
                                <TextBlock Margin="0,12,0,4" Style="{DynamicResource Text.Muted}" Text="Checklist" />
                                <ItemsControl ItemsSource="{Binding FormChecklist}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ChecklistItemViewModel}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Width="24" Height="24"
                                                        Style="{DynamicResource Button.Icon}"
                                                        Content="{DynamicResource Glyph.Close}"
                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Remove item"
                                                        AutomationProperties.Name="Remove item" />
                                                <CheckBox Style="{DynamicResource CheckBox.Tick}" IsChecked="{Binding IsDone}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                </CheckBox>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Margin="0,4,0,0"
                                         Tag="Add item"
                                         Text="{Binding NewItemText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Add checklist item">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding AddItemCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>

                                <TextBox Margin="0,12,0,0"
                                         MinHeight="64"
                                         Padding="8,6"
                                         VerticalContentAlignment="Top"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Tag="Note"
                                         Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Note" />

                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </DockPanel>
                </Grid>
            </Border>

                        <Border x:Name="SearchPanel" Grid.Column="1" Panel.ZIndex="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20,48,0,0" Width="332" Padding="12" Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVisibility}}" CornerRadius="12"
                                Background="{DynamicResource Brush.Window}"
                                BorderBrush="{DynamicResource Brush.RuleStrong}" BorderThickness="1"
                                TextElement.Foreground="{DynamicResource Brush.Text}"
                                TextElement.FontFamily="{DynamicResource Font.UI}"
                                TextElement.FontSize="{DynamicResource Size.Body}">
                            <StackPanel>
                                <TextBox Tag="Search events, or type a date"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         IsVisibleChanged="OnTitleBoxVisibleChanged"
                                         AutomationProperties.Name="Search">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding GoToFirstResultCommand}" />
                                        <KeyBinding Key="Escape" Command="{Binding CloseSearchCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Margin="4,10,0,0" Style="{DynamicResource Text.Muted}" Text="Nothing found"
                                           Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVisibility}}" />
                                <ScrollViewer Margin="-4,8,-4,0" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <ItemsControl ItemsSource="{Binding SearchResults}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SearchResultItemViewModel}">
                                                <Button Padding="8,6"
                                                        Style="{DynamicResource Button.Bare}"
                                                        Command="{Binding DataContext.GoToResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Title}">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="Medium" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                                        <TextBlock Style="{DynamicResource Text.Muted}" TextTrimming="CharacterEllipsis" Text="{Binding Detail}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

            <!-- ============ Calendar side ============ -->
            <DockPanel Grid.Column="1" Margin="20,0,0,0">

                <!-- Header -->
                <Grid x:Name="CalendarToolbar" DockPanel.Dock="Top" SizeChanged="OnCalendarToolbarSizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="36" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Search: type to find events, or type a date to jump to it. Opens with Ctrl+F. -->


                    <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run FontSize="{DynamicResource Size.Title}" FontWeight="SemiBold" Text="{Binding Title, Mode=OneWay}" />
                        <Run Text=" " />
                        <Run FontSize="{DynamicResource Size.Title}" Foreground="{DynamicResource Brush.TextDim}" Text="{Binding TitleYear, Mode=OneWay}" />
                    </TextBlock>

                    <ListBox Grid.Row="1" Grid.Column="0"
                             Margin="0"
                             VerticalAlignment="Center"
                             Style="{DynamicResource ListBox.Segmented}"
                             ItemsSource="{Binding ViewOptions}"
                             SelectedItem="{Binding SelectedView}"
                             DisplayMemberPath="Name"
                             AutomationProperties.Name="Calendar view"
                             WindowChrome.IsHitTestVisibleInChrome="True" />

                    <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Margin="8,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{DynamicResource Button.Icon}"
                                Content="{DynamicResource Glyph.ChevronLeft}"
                                Command="{Binding PreviousCommand}"
                                ToolTip="Previous (Ctrl+Left)"
                                AutomationProperties.Name="Previous"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Style="{DynamicResource Button.Text}"
                                Padding="8,0"
                                Content="Today"
                                Command="{Binding GoToTodayCommand}"
                                ToolTip="Ctrl+T"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Style="{DynamicResource Button.Icon}"
                                Content="{DynamicResource Glyph.ChevronRight}"
                                Command="{Binding NextCommand}"
                                ToolTip="Next (Ctrl+Right)"
                                AutomationProperties.Name="Next"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Margin="8,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SearchButton"
                                Style="{DynamicResource Button.Icon}"
                                Content="{DynamicResource Glyph.Search}"
                                Command="{Binding OpenSearchCommand}"
                                ToolTip="Search (Ctrl+F)"
                                AutomationProperties.Name="Search"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Command="{Binding ToggleLockCommand}"
                                ToolTip="{Binding LockToolTip}"
                                AutomationProperties.Name="{Binding LockToolTip}"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                    <Setter Property="Content" Value="{DynamicResource Glyph.Unlock}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                            <Setter Property="Content" Value="{DynamicResource Glyph.Lock}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{DynamicResource Button.Icon}"
                                Content="{DynamicResource Glyph.Settings}"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip="Settings"
                                AutomationProperties.Name="Settings"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Style="{DynamicResource Button.Icon}"
                                Content="{DynamicResource Glyph.Close}"
                                Click="OnHideClick"
                                ToolTip="Hide to tray"
                                AutomationProperties.Name="Hide to tray"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">

                    <!-- Month view -->
                    <DockPanel Visibility="{Binding IsMonthView, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl DockPanel.Dock="Top" Height="24" ItemsSource="{Binding WeekdayNames}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="10,0,0,0" HorizontalAlignment="Left" Style="{DynamicResource Text.Label}" Foreground="{DynamicResource Brush.TextDim}" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Hairline grid: each cell draws its right and bottom rule; the outer 1px is clipped. -->
                        <Border BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="0,1,0,0" ClipToBounds="True">
                        <ItemsControl Margin="0,0,-1,-1" x:Name="MonthDaysGrid" ItemsSource="{Binding MonthDays}" Focusable="False" SizeChanged="OnMonthGridSizeChanged">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="{Binding MonthWeekCount}" Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DayCellViewModel}">
                                    <Border x:Name="Cell"
                                            BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="0,0,1,1"
                                            Background="Transparent"
                                            AllowDrop="True"
                                            DragOver="OnDayDragOver" DragLeave="OnDayDragLeave" Drop="OnDayDrop">
                                    <Button Margin="2"
                                            Style="{DynamicResource Button.Bare}"
                                            PreviewMouseLeftButtonDown="OnEventPress"
                                            PreviewMouseLeftButtonUp="OnEventRelease"
                                            PreviewMouseMove="OnEventMove"
                                            Command="{Binding SelectCommand}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTipService.IsEnabled="{Binding HasEvents}"
                                            ToolTipService.InitialShowDelay="500"
                                            ToolTipService.Placement="Right"
                                            ToolTipService.HorizontalOffset="8"
                                            AutomationProperties.Name="{Binding AccessibleName}">
                                        <!-- Right-click a day for the quick actions. -->
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="New event"
                                                          Command="{Binding PlacementTarget.Tag.NewEventOnCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Open day"
                                                          Command="{Binding PlacementTarget.Tag.OpenDayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <!-- Hover for a moment: every event of the day, with its time. -->
                                        <Button.ToolTip>
                                            <ToolTip Style="{DynamicResource ToolTip.Card}">
                                                <StackPanel MinWidth="180" MaxWidth="320" TextElement.FontSize="{DynamicResource Size.Body}">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding LongDate}" />
                                                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Events}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:EventItemViewModel}">
                                                                <StackPanel Margin="0,0,0,8">
                                                                    <TextBlock TextWrapping="Wrap" FontWeight="Medium" Text="{Binding Title}" />
                                                                    <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding AgendaTime}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                        <!-- Day number top-left, then as many event titles as fit, as plain text. -->
                                        <DockPanel Margin="6" LastChildFill="False">
                                            <Grid DockPanel.Dock="Top" Height="{DynamicResource Size.MonthHeader}">
                                            <Border x:Name="Mark" VerticalAlignment="Top"
                                                    HorizontalAlignment="Left"
                                                    MinWidth="26" Height="{DynamicResource Size.MonthBadge}"
                                                    Padding="6,0"
                                                    CornerRadius="13">
                                                <TextBlock x:Name="Number"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource Brush.Text}"
                                                           Text="{Binding DayNumber}" />
                                            </Border>
                                            <Ellipse x:Name="CompactEventDot" Width="4" Height="4" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                     Fill="{DynamicResource Brush.Accent}" Visibility="{Binding ShowCompactEventIndicator, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                            <ItemsControl x:Name="Lines" DockPanel.Dock="Top" Margin="2,4,0,0" ItemsSource="{Binding CellEvents}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:EventItemViewModel}">
                                                        <DockPanel Height="{DynamicResource Size.MonthEventLine}">
                                                            <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.Accent}" />
                                                            <TextBlock FontSize="{DynamicResource Size.Small}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock DockPanel.Dock="Top"
                                                       Margin="13,0,0,0"
                                                       FontSize="{DynamicResource Size.Small}"
                                                       Foreground="{DynamicResource Brush.TextMuted}"
                                                       Height="{DynamicResource Size.MonthEventLine}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding MoreText}"
                                                       Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
                                        </DockPanel>
                                    </Button>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsInMonth}" Value="False">
                                            <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
                                            <Setter TargetName="Number" Property="FontWeight" Value="Normal" />
                                            <Setter TargetName="Lines" Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Mark" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                            <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                            <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter TargetName="Mark" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                            <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                            <Setter TargetName="Number" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Border>
                    </DockPanel>

                    <!-- Week view: seven columns, each day's events listed -->
                    <ItemsControl ItemsSource="{Binding WeekDays}"
                                  Focusable="False"
                                  Visibility="{Binding IsWeekView, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DayCellViewModel}">
                                <Border x:Name="Column" Margin="2" CornerRadius="10" Background="{DynamicResource Brush.Surface}"
                                        AllowDrop="True" DragOver="OnDayDragOver" DragLeave="OnDayDragLeave" Drop="OnDayDrop">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Top"
                                                Padding="8"
                                                Style="{DynamicResource Button.Bare}"
                                                Command="{Binding SelectCommand}"
                                                AutomationProperties.Name="{Binding AccessibleName}">
                                            <!-- Weekday and number side by side, top-left. -->
                                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                <Border x:Name="Mark" MinWidth="26" Height="{DynamicResource Size.MonthBadge}" Padding="6,0" CornerRadius="13">
                                                    <TextBlock x:Name="Number"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding DayNumber}" />
                                                </Border>
                                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Text.Label}" Foreground="{DynamicResource Brush.TextDim}" Text="{Binding WeekdayShort}" />
                                            </StackPanel>
                                        </Button>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                            <ItemsControl Margin="4,0,4,4" ItemsSource="{Binding Events}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:EventItemViewModel}">
                                                        <Button Margin="0,0,0,4"
                                                                Padding="6"
                                                                Style="{DynamicResource Button.Bare}"
                                                                PreviewMouseLeftButtonDown="OnEventPress"
                                                                PreviewMouseLeftButtonUp="OnEventRelease"
                                                                PreviewMouseMove="OnEventMove"
                                                                Background="{DynamicResource Brush.AccentSoft}"
                                                                Command="{Binding DataContext.OpenEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                AutomationProperties.Name="{Binding Title}">
                                                            <StackPanel>
                                                                <TextBlock FontSize="{DynamicResource Size.Small}" FontWeight="Medium" Text="{Binding Title}" TextWrapping="Wrap" />
                                                                <TextBlock FontSize="{DynamicResource Size.Small}"
                                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                                           Text="{Binding TimeText}"
                                                                           Visibility="{Binding HasTime, Converter={StaticResource BoolToVisibility}}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Column" Property="Background" Value="{DynamicResource Brush.Card}" />
                                        <Setter TargetName="Mark" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                        <Setter TargetName="Column" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter TargetName="Mark" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                        <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Day view: hour timeline for the selected day -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  Visibility="{Binding IsDayView, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Hours}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HourRowViewModel}">
                                    <Grid MinHeight="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Label"
                                                   Margin="0,4,0,0"
                                                   Style="{DynamicResource Text.Label}"
                                                   Foreground="{DynamicResource Brush.TextDim}"
                                                   Text="{Binding Label}" />
                                        <Border x:Name="Rule" Grid.Column="1" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="0,1,0,0" Padding="0,4,4,0">
                                            <ItemsControl ItemsSource="{Binding Events}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:EventItemViewModel}">
                                                        <Button Margin="0,0,0,4"
                                                                Padding="10,6"
                                                                Style="{DynamicResource Button.Bare}"
                                                                Background="{DynamicResource Brush.AccentSoft}"
                                                                Command="{Binding DataContext.OpenEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                AutomationProperties.Name="{Binding Title}">
                                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                                <Run FontWeight="Medium" Text="{Binding Title, Mode=OneWay}" />
                                                                <Run Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding TimeText, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsNow}" Value="True">
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                            <Setter TargetName="Rule" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            <Setter TargetName="Rule" Property="BorderThickness" Value="0,2,0,0" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
