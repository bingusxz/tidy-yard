<Window x:Class="TidyYard.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TidyYard.ViewModels"
        xmlns:views="clr-namespace:TidyYard.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Tidy Yard Settings"
        Style="{DynamicResource Style.Window}"
        WindowStyle="None"
        ResizeMode="CanResize"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Width="780" Height="620"
        WindowStartupLocation="CenterScreen">

    <!-- CanResize keeps the system frame Windows needs for the acrylic backdrop;
         ResizeBorderThickness 0 means the edges do not actually resize. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- One settings row: label and hint on the left, control on the right. -->
        <Style x:Key="Row" TargetType="Grid">
            <!-- 4px above and below, so the space around dividers and at the card edges is equal. -->
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="MinHeight" Value="48" />
        </Style>

        <views:InverseBooleanConverter x:Key="Inverse" />

        <!-- Sidebar list: plain text entries, soft accent fill on the one open. -->
        <Style x:Key="Nav.List" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                        <Setter Property="FontWeight" Value="Medium" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Height="36" Padding="12,0" CornerRadius="8" Background="Transparent">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pages: each shows only while its sidebar entry is selected. -->
        <Style x:Key="Page" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="Page0" TargetType="StackPanel" BasedOn="{StaticResource Page}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=Nav}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Page1" TargetType="StackPanel" BasedOn="{StaticResource Page}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=Nav}" Value="1">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Page2" TargetType="StackPanel" BasedOn="{StaticResource Page}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=Nav}" Value="2">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Page3" TargetType="StackPanel" BasedOn="{StaticResource Page}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=Nav}" Value="3">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Page4" TargetType="StackPanel" BasedOn="{StaticResource Page}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=Nav}" Value="4">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Page5" TargetType="StackPanel" BasedOn="{StaticResource Page}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=Nav}" Value="5">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Round colour swatch that opens the picker. Background = the colour shown. -->
        <Style x:Key="Swatch" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Ring" CornerRadius="16" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                            <Border CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Brush.RuleStrong}" BorderThickness="1" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.RuleStrong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickerCard" TargetType="Border">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.RuleStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="TextElement.FontFamily" Value="{DynamicResource Font.UI}" />
            <Setter Property="TextElement.FontSize" Value="{DynamicResource Size.Body}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="{DynamicResource Brush.Glass}" Opacity="0.92" />

        <DockPanel Margin="24,12,8,24">
            <!-- Header -->
            <Grid DockPanel.Dock="Top" Height="44" Margin="0,0,8,0">
                <TextBlock VerticalAlignment="Center" Style="{DynamicResource Text.Title}" Text="Settings" />
                <Button HorizontalAlignment="Right"
                        Style="{DynamicResource Button.Icon}"
                        Content="{DynamicResource Glyph.Close}"
                        Click="OnCloseClick"
                        ToolTip="Close"
                        AutomationProperties.Name="Close"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>

            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="168" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: one entry per page. -->
            <ListBox x:Name="Nav"
                     Margin="0,8,16,0"
                     Style="{StaticResource Nav.List}"
                     SelectedIndex="0"
                     AutomationProperties.Name="Settings sections">
                <ListBoxItem Content="Appearance" />
                <ListBoxItem Content="Calendar" />
                <ListBoxItem Content="Plots" />
                <ListBoxItem Content="Notepad" />
                <ListBoxItem Content="Auto-sort" />
                <ListBoxItem Content="General" />
            </ListBox>

            <!-- Scrolls when a page is taller than the window; the window never grows taller than the work area. -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,8,0">

            <!-- Appearance -->
            <StackPanel Style="{StaticResource Page0}">
            <TextBlock Margin="0,16,0,8" Style="{DynamicResource Text.Label}" Text="APPEARANCE" />
            <Border Background="{DynamicResource Brush.Card}" CornerRadius="12" Padding="16,8" Margin="0,0,8,0">
                <StackPanel>
                    <!-- Theme: a chip per theme showing its glass colour and accent. -->
                    <StackPanel Margin="0,8,0,8">
                        <TextBlock FontWeight="Medium" Text="Theme" />
                        <ListBox Margin="-4,8,0,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ItemsSource="{Binding Themes}"
                                 SelectedItem="{Binding SelectedTheme}"
                                 AutomationProperties.Name="Theme">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Ring" Width="92" Margin="4" Padding="4" CornerRadius="12"
                                                        BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                                                    <StackPanel>
                                                        <!-- A tiny calendar in the theme: a month title, a row of days, today in the accent. -->
                                                        <Border Height="40" CornerRadius="8" Background="{Binding SwatchBrush}"
                                                                BorderBrush="{DynamicResource Brush.RuleStrong}" BorderThickness="1">
                                                            <Grid Margin="8,7,8,7">
                                                                <Border Width="30" Height="4" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{Binding InkBrush}" />
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                                    <Ellipse Width="12" Height="12" Margin="0,0,6,0" Fill="{Binding DotBrush}" />
                                                                    <Border Width="9" Height="3" CornerRadius="1.5" Margin="0,0,6,0" VerticalAlignment="Center" Background="{Binding InkBrush}" />
                                                                    <Border Width="9" Height="3" CornerRadius="1.5" Margin="0,0,6,0" VerticalAlignment="Center" Background="{Binding InkBrush}" />
                                                                    <Border Width="9" Height="3" CornerRadius="1.5" VerticalAlignment="Center" Background="{Binding InkBrush}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Margin="0,6,0,2" HorizontalAlignment="Center"
                                                                   FontSize="{DynamicResource Size.Small}"
                                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                                   Text="{Binding Name}" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.RuleStrong}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource Brush.Rule}" />

                    <!-- Accent colour -->
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="Accent colour" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Style="{DynamicResource Button.Text}"
                                    Content="Reset"
                                    Command="{Binding ResetAccentCommand}"
                                    AutomationProperties.Name="Reset accent colour"
                                    Visibility="{Binding HasCustomAccent, Converter={StaticResource BoolToVisibility}}" />
                            <ToggleButton x:Name="AccentSwatch"
                                          Style="{StaticResource Swatch}"
                                          IsHitTestVisible="{Binding IsOpen, ElementName=AccentPopup, Converter={StaticResource Inverse}}"
                                          ToolTip="Choose accent colour"
                                          AutomationProperties.Name="Choose accent colour">
                                <ToggleButton.Background>
                                    <SolidColorBrush Color="{Binding AccentColor}" />
                                </ToggleButton.Background>
                            </ToggleButton>
                            <Popup x:Name="AccentPopup"
                                   IsOpen="{Binding IsChecked, ElementName=AccentSwatch, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=AccentSwatch}"
                                   Placement="Bottom"
                                   HorizontalOffset="-232"
                                   StaysOpen="False"
                                   AllowsTransparency="True">
                                <Border Style="{StaticResource PickerCard}">
                                    <views:ColorPicker SelectedColor="{Binding AccentColor}" Presets="{Binding AccentPresets}" />
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Rule}" />

                    <!-- Background tint -->
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="Background tint" />
                            <TextBlock Margin="0,2,0,0"
                                       Style="{DynamicResource Text.Muted}"
                                       Foreground="{DynamicResource Brush.Warning}"
                                       Text="{Binding TintWarning}"
                                       Visibility="{Binding HasTintWarning, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Style="{DynamicResource Button.Text}"
                                    Content="Reset"
                                    Command="{Binding ResetTintCommand}"
                                    AutomationProperties.Name="Reset background tint"
                                    Visibility="{Binding HasCustomTint, Converter={StaticResource BoolToVisibility}}" />
                            <ToggleButton x:Name="TintSwatch"
                                          Style="{StaticResource Swatch}"
                                          IsHitTestVisible="{Binding IsOpen, ElementName=TintPopup, Converter={StaticResource Inverse}}"
                                          ToolTip="Choose background tint"
                                          AutomationProperties.Name="Choose background tint">
                                <ToggleButton.Background>
                                    <SolidColorBrush Color="{Binding TintColor}" />
                                </ToggleButton.Background>
                            </ToggleButton>
                            <Popup x:Name="TintPopup"
                                   IsOpen="{Binding IsChecked, ElementName=TintSwatch, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=TintSwatch}"
                                   Placement="Bottom"
                                   HorizontalOffset="-232"
                                   StaysOpen="False"
                                   AllowsTransparency="True">
                                <Border Style="{StaticResource PickerCard}">
                                    <views:ColorPicker SelectedColor="{Binding TintColor}" Presets="{Binding TintPresets}" />
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Rule}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="Calendar opacity" />
                            <TextBlock Style="{DynamicResource Text.Muted}" Text="Only the calendar. At 0%, its background is transparent." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <Slider Width="140"
                                    VerticalAlignment="Center"
                                    Minimum="{Binding MinOpacity}"
                                    Maximum="{Binding MaxOpacity}"
                                    SmallChange="1"
                                    LargeChange="5"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding OpacityPercent}"
                                    AutomationProperties.Name="Calendar opacity" />
                            <TextBlock Width="44" VerticalAlignment="Center" TextAlignment="Right" FontWeight="Medium" Text="{Binding OpacityText}" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Rule}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="Plot opacity" />
                            <TextBlock Style="{DynamicResource Text.Muted}" Text="Only plots. Keep their backgrounds visible while the calendar is transparent." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <Slider Width="140"
                                    VerticalAlignment="Center"
                                    Minimum="{Binding MinOpacity}"
                                    Maximum="{Binding MaxOpacity}"
                                    SmallChange="1"
                                    LargeChange="5"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding PlotOpacityPercent}"
                                    AutomationProperties.Name="Plot opacity" />
                            <TextBlock Width="44" VerticalAlignment="Center" TextAlignment="Right" FontWeight="Medium" Text="{Binding PlotOpacityText}" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Rule}" />
                    <Grid Style="{StaticResource Row}">
                        <TextBlock VerticalAlignment="Center" FontWeight="Medium" Text="Time format" />
                        <ListBox HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Style="{DynamicResource ListBox.Segmented}"
                                 ItemsSource="{Binding ClockOptions}"
                                 SelectedItem="{Binding SelectedClock}"
                                 DisplayMemberPath="Name"
                                 AutomationProperties.Name="Time format" />
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Widget -->
            <StackPanel Style="{StaticResource Page1}">
            <TextBlock Margin="0,20,0,8" Style="{DynamicResource Text.Label}" Text="CALENDAR" />
            <Border Background="{DynamicResource Brush.Card}" CornerRadius="12" Padding="16,8" Margin="0,0,8,0">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="Default reminder" />
                            <TextBlock Style="{DynamicResource Text.Muted}" Text="Given to new events that have a time. You can change it per event." />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  Width="176"
                                  VerticalAlignment="Center"
                                  Style="{DynamicResource ComboBox.Flat}"
                                  ItemsSource="{Binding ReminderOptions}"
                                  SelectedItem="{Binding SelectedReminder}"
                                  DisplayMemberPath="Name"
                                  AutomationProperties.Name="Default reminder" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Rule}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="Show calendar" />
                            <TextBlock Style="{DynamicResource Text.Muted}" Text="Turn off to use Tidy Yard for plots only. Open Calendar in the tray still works." />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{DynamicResource CheckBox.Switch}"
                                  IsChecked="{Binding ShowCalendar}"
                                  AutomationProperties.Name="Show calendar" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Rule}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="Lock position" />
                            <TextBlock Style="{DynamicResource Text.Muted}" Text="Pins the calendar to the desktop: behind your windows, still there on Show desktop, no dragging." />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{DynamicResource CheckBox.Switch}"
                                  IsChecked="{Binding IsLocked}"
                                  AutomationProperties.Name="Lock position" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Rule}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="Start with Windows" />
                            <TextBlock Style="{DynamicResource Text.Muted}" Text="Starts Tidy Yard when you sign in, with plots and calendar where you left them." />
                            <TextBlock Style="{DynamicResource Text.Muted}"
                                       Foreground="{DynamicResource Brush.Danger}"
                                       Text="{Binding StartupError}"
                                       Visibility="{Binding HasStartupError, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{DynamicResource CheckBox.Switch}"
                                  IsChecked="{Binding StartWithWindows}"
                                  AutomationProperties.Name="Start with Windows" />
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Your plots: all of them in one place -->
            <StackPanel Style="{StaticResource Page2}">
            <TextBlock Margin="0,16,0,8" Style="{DynamicResource Text.Label}" Text="YOUR PLOTS" />
            <Border Background="{DynamicResource Brush.Card}" CornerRadius="12" Padding="16,12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.Muted}" Text="New plot" />
                    <StackPanel Margin="-8,4,0,0" Orientation="Horizontal">
                        <Button Style="{DynamicResource Button.Text}" Content="Blank" Command="{Binding NewPlotCommand}" />
                        <ItemsControl ItemsSource="{Binding PlotTemplates}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{DynamicResource Button.Text}"
                                            Content="{Binding Title}"
                                            Command="{Binding DataContext.NewPlotFromTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                               Text="A template makes a folder of that name and adds a sort rule for its file types. Sorting stays off until you turn it on. Win+Alt+N makes a plot where the pointer is." />

                    <Border Height="1" Margin="0,12,0,4" Background="{DynamicResource Brush.Rule}" />

                    <TextBlock Margin="0,8,0,0" Text="Nothing scheduled">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Plots.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding Plots}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FenceViewModel}">
                                <Grid MinHeight="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock FontWeight="Medium" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                        <TextBlock Style="{DynamicResource Text.Muted}" TextTrimming="CharacterEllipsis" Text="{Binding CountText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Width="28" Height="28"
                                                Command="{Binding ToggleLockCommand}"
                                                ToolTip="{Binding LockToolTip}"
                                                AutomationProperties.Name="{Binding LockToolTip}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                                    <Setter Property="Content" Value="{DynamicResource Glyph.Unlock}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                            <Setter Property="Content" Value="{DynamicResource Glyph.Lock}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Width="28" Height="28" Margin="2,0,0,0"
                                                Command="{Binding ToggleRollUpCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                                    <Setter Property="Content" Value="{DynamicResource Glyph.ChevronUp}" />
                                                    <Setter Property="ToolTip" Value="Roll up" />
                                                    <Setter Property="AutomationProperties.Name" Value="Roll up" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRolledUp}" Value="True">
                                                            <Setter Property="Content" Value="{DynamicResource Glyph.ChevronDown}" />
                                                            <Setter Property="ToolTip" Value="Roll down" />
                                                            <Setter Property="AutomationProperties.Name" Value="Roll down" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Margin="4,0,0,0"
                                                Style="{DynamicResource Button.Text}"
                                                Content="Remove"
                                                Command="{Binding RemoveCommand}"
                                                ToolTip="Removes the plot. Its folder and files stay where they are." />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="-8,8,0,0" Orientation="Horizontal">
                        <Button Style="{DynamicResource Button.Text}" Content="Lock all" Command="{Binding LockAllPlotsCommand}" />
                        <Button Style="{DynamicResource Button.Text}" Content="Unlock all" Command="{Binding UnlockAllPlotsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Fences -->
            <StackPanel Style="{StaticResource Page2}">
            <TextBlock Margin="0,20,0,8" Style="{DynamicResource Text.Label}" Text="PLOTS" />
            <Border Background="{DynamicResource Brush.Card}" CornerRadius="12" Padding="16,8" Margin="0,0,8,0">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock VerticalAlignment="Center" FontWeight="Medium" Text="Icon size" />
                        <ListBox HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Style="{DynamicResource ListBox.Segmented}"
                                 ItemsSource="{Binding IconSizes}"
                                 SelectedItem="{Binding SelectedIconSize}"
                                 DisplayMemberPath="Name"
                                 AutomationProperties.Name="Plot icon size" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Rule}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="Hide desktop icons" />
                            <TextBlock Style="{DynamicResource Text.Muted}" Text="Same as right-click desktop > View > Show desktop icons. Plots stay visible." />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{DynamicResource CheckBox.Switch}"
                                  IsChecked="{Binding HideDesktopIcons}"
                                  AutomationProperties.Name="Hide desktop icons" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Rule}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="Tidy desktop" />
                            <TextBlock Style="{DynamicResource Text.Muted}" Text="Sorts loose desktop files into plots by type. Shows you the plan first." />
                        </StackPanel>
                        <Button Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{DynamicResource Button.Text}"
                                Content="Tidy…"
                                Command="{Binding TidyDesktopCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Notepad -->
            <StackPanel Style="{StaticResource Page3}">
            <TextBlock Margin="0,20,0,8" Style="{DynamicResource Text.Label}" Text="NOTEPAD" />
            <Border Background="{DynamicResource Brush.Card}" CornerRadius="12" Padding="16,8" Margin="0,0,8,0">
                <StackPanel>
                    <!-- Preview: the sheet as it will be drawn, including ink that was adjusted to stay readable. -->
                    <Border Margin="0,8,0,8" CornerRadius="4" Padding="14,6" BorderBrush="{DynamicResource Brush.RuleStrong}" BorderThickness="1"
                            Background="{Binding NotepadPreviewPaper}" AutomationProperties.Name="Notepad preview">
                        <StackPanel>
                            <Border Height="{Binding NotepadPreviewPitch}" BorderThickness="0,0,0,1" BorderBrush="{Binding NotepadPreviewRule}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NotepadPreviewRuled}" Value="False">
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock VerticalAlignment="Bottom" Text="Call the bank before 3pm"
                                           FontFamily="{Binding NotepadPreviewFont}" FontSize="{Binding NotepadPreviewSize}" Foreground="{Binding NotepadPreviewInk}" />
                            </Border>
                            <Border Height="{Binding NotepadPreviewPitch}" BorderThickness="0,0,0,1" BorderBrush="{Binding NotepadPreviewRule}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NotepadPreviewRuled}" Value="False">
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock VerticalAlignment="Bottom" Text="Pick up the parcel on Friday"
                                           FontFamily="{Binding NotepadPreviewFont}" FontSize="{Binding NotepadPreviewSize}" Foreground="{Binding NotepadPreviewInk}" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Height="1" Background="{DynamicResource Brush.Rule}" />

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="Design" />
                            <TextBlock Style="{DynamicResource Text.Muted}" Text="Applies to the notepad and to sticky notes." />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="176" VerticalAlignment="Center" Style="{DynamicResource ComboBox.Flat}"
                                  ItemsSource="{Binding NotepadDesignOptions}" SelectedItem="{Binding SelectedNotepadDesign}"
                                  DisplayMemberPath="Name" AutomationProperties.Name="Notepad design" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Rule}" />

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontWeight="Medium" Text="Font" />
                        <ComboBox Grid.Column="1" Width="176" VerticalAlignment="Center" Style="{DynamicResource ComboBox.Flat}"
                                  ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding NotepadFont}" AutomationProperties.Name="Notepad font" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Rule}" />

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontWeight="Medium" Text="Text size" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <Slider Width="140" VerticalAlignment="Center" Minimum="10" Maximum="28" SmallChange="1" LargeChange="2" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Value="{Binding NotepadFontSize}" AutomationProperties.Name="Notepad text size" />
                            <TextBlock Width="52" VerticalAlignment="Center" TextAlignment="Right" FontWeight="Medium" Text="{Binding NotepadFontSizeText}" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Rule}" />

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="Ink colour" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <ToggleButton x:Name="InkSwatch" Style="{StaticResource Swatch}"
                                          IsHitTestVisible="{Binding IsOpen, ElementName=InkPopup, Converter={StaticResource Inverse}}"
                                          ToolTip="Choose ink colour" AutomationProperties.Name="Choose ink colour">
                                <ToggleButton.Background><SolidColorBrush Color="{Binding NotepadInk}" /></ToggleButton.Background>
                            </ToggleButton>
                            <Popup x:Name="InkPopup" IsOpen="{Binding IsChecked, ElementName=InkSwatch, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=InkSwatch}" Placement="Bottom" HorizontalOffset="-232" StaysOpen="False" AllowsTransparency="True">
                                <Border Style="{StaticResource PickerCard}">
                                    <views:ColorPicker SelectedColor="{Binding NotepadInk}" Presets="{Binding InkPresets}" />
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Rule}" />

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="Paper colour" />
                            <TextBlock Style="{DynamicResource Text.Muted}" Text="Each note can pick its own." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <ToggleButton x:Name="PaperSwatch" Style="{StaticResource Swatch}"
                                          IsHitTestVisible="{Binding IsOpen, ElementName=PaperPopup, Converter={StaticResource Inverse}}"
                                          ToolTip="Choose paper colour" AutomationProperties.Name="Choose paper colour">
                                <ToggleButton.Background><SolidColorBrush Color="{Binding NotepadPaper}" /></ToggleButton.Background>
                            </ToggleButton>
                            <Popup x:Name="PaperPopup" IsOpen="{Binding IsChecked, ElementName=PaperSwatch, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=PaperSwatch}" Placement="Bottom" HorizontalOffset="-232" StaysOpen="False" AllowsTransparency="True">
                                <Border Style="{StaticResource PickerCard}">
                                    <views:ColorPicker SelectedColor="{Binding NotepadPaper}" Presets="{Binding PaperPresets}" />
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Rule}" />

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="Ruled lines" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource CheckBox.Switch}"
                                  IsChecked="{Binding NotepadRuled}" AutomationProperties.Name="Ruled lines" />
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Auto-sort -->
            <StackPanel Style="{StaticResource Page4}">
            <TextBlock Margin="0,20,0,8" Style="{DynamicResource Text.Label}" Text="AUTO-SORT" />
            <Border Background="{DynamicResource Brush.Card}" CornerRadius="12" Padding="16,12" Margin="0,0,8,0">
                <StackPanel DataContext="{Binding AutoSort}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="Sort new desktop files" />
                            <TextBlock Margin="0,2,0,0" Style="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                                       Text="Moves each new file that matches a rule into a plot. Files already on the desktop are left alone. Every move is logged, and the notification has an Undo button." />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{DynamicResource CheckBox.Switch}"
                                  IsChecked="{Binding IsEnabled}"
                                  AutomationProperties.Name="Sort new desktop files" />
                    </Grid>

                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Rules}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SortRuleItemViewModel}">
                                <Grid MinHeight="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource Brush.Rule}" />
                                    <TextBlock Margin="0,8,12,8" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Summary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{DynamicResource Button.Text}"
                                            Content="Remove"
                                            Command="{Binding RemoveCommand}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Remove rule" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Margin="0,4,0,12" Background="{DynamicResource Brush.Rule}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Create a plot first, then add a rule."
                               Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDestinations}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Visibility="{Binding HasDestinations, Converter={StaticResource BoolToVisibility}}">
                        <TextBox Tag="File types, like pdf, docx"
                                 Text="{Binding NewTypes, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="File types" />
                        <TextBox Margin="0,8,0,0"
                                 Tag="Name contains (optional), like invoice"
                                 Text="{Binding NewWord, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Name contains" />
                        <TextBlock Margin="2,8,0,4" Style="{DynamicResource Text.Muted}" Text="Move them to" />
                        <ComboBox Style="{DynamicResource ComboBox.Flat}"
                                  ItemsSource="{Binding Destinations}"
                                  SelectedItem="{Binding SelectedDestination}"
                                  DisplayMemberPath="Name"
                                  AutomationProperties.Name="Destination plot" />
                        <TextBlock Margin="2,8,0,0"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   TextWrapping="Wrap"
                                   Text="{Binding Error}"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                        <Button Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Style="{DynamicResource Button.Primary}"
                                Content="Add rule"
                                Command="{Binding AddCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Calendar links -->
            <StackPanel Style="{StaticResource Page1}">
            <TextBlock Margin="0,20,0,8" Style="{DynamicResource Text.Label}" Text="CALENDAR LINKS" />
            <Border Background="{DynamicResource Brush.Card}" CornerRadius="12" Padding="16,12" Margin="0,0,8,0">
                <StackPanel DataContext="{Binding Links}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock FontWeight="Medium" Text="Show events from another calendar" />
                            <TextBlock Margin="0,2,0,0" Style="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                                       Text="Works with Google Calendar, Outlook and iCloud. Events appear here but are edited in the original calendar. Nothing is sent anywhere: this PC reads the link directly." />
                        </StackPanel>
                        <Button Grid.Column="1"
                                VerticalAlignment="Top"
                                Style="{DynamicResource Button.Text}"
                                Content="Refresh now"
                                Command="{Binding RefreshCommand}" />
                    </Grid>

                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Sources}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CalendarLinkItemViewModel}">
                                <Grid MinHeight="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource Brush.Rule}" />
                                    <StackPanel Margin="0,8,12,8" VerticalAlignment="Center">
                                        <TextBlock FontWeight="Medium" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding Host, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{DynamicResource Button.Text}"
                                            Content="Remove"
                                            Command="{Binding RemoveCommand}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Remove calendar" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Margin="0,4,0,12" Background="{DynamicResource Brush.Rule}" />
                    <TextBox Tag="Name, like Work"
                             Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Calendar name" />
                    <TextBox Margin="0,8,0,0"
                             Tag="Secret iCal link, starting with https://"
                             Text="{Binding NewLink, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Calendar link" />
                    <TextBlock Margin="2,6,0,0" Style="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                               Text="Google: open Calendar on the web, then Settings, your calendar, Integrate calendar, Secret address in iCal format. Anyone with this link can read that calendar, so keep it private." />
                    <TextBlock Margin="2,8,0,0"
                               FontWeight="Medium"
                               Foreground="{DynamicResource Brush.Danger}"
                               TextWrapping="Wrap"
                               Text="{Binding Error}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Button Style="{DynamicResource Button.Primary}"
                                Content="Add calendar"
                                Command="{Binding AddCommand}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Text.Muted}" Text="{Binding BusyText}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Updates -->
            <StackPanel Style="{StaticResource Page5}">
            <TextBlock Margin="0,20,0,8" Style="{DynamicResource Text.Label}" Text="UPDATES" />
            <Border Background="{DynamicResource Brush.Card}" CornerRadius="12" Padding="16,8" Margin="0,0,8,0">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="{Binding VersionText}" />
                            <TextBlock Style="{DynamicResource Text.Muted}" TextWrapping="Wrap" Text="{Binding UpdateStatus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource Button.Text}"
                                    Content="Check now"
                                    Command="{Binding CheckNowCommand}" />
                            <Button Margin="4,0,0,0"
                                    Style="{DynamicResource Button.Primary}"
                                    Content="Restart and update"
                                    Command="{Binding InstallUpdateCommand}"
                                    Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Rule}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="Check automatically" />
                            <TextBlock Style="{DynamicResource Text.Muted}" Text="Downloads new versions in the background. Your data is never touched." />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{DynamicResource CheckBox.Switch}"
                                  IsChecked="{Binding CheckForUpdates}"
                                  AutomationProperties.Name="Check for updates automatically" />
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Data -->
            <StackPanel Style="{StaticResource Page5}">
            <TextBlock Margin="0,20,0,8" Style="{DynamicResource Text.Label}" Text="DATA" />
            <Border Background="{DynamicResource Brush.Card}" CornerRadius="12" Padding="16,8" Margin="0,0,8,0">
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="Medium" Text="Data folder" />
                        <TextBlock Style="{DynamicResource Text.Muted}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding DataFolder}"
                                   ToolTip="{Binding DataFolder}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{DynamicResource Button.Text}"
                            Content="Open"
                            Command="{Binding OpenDataFolderCommand}" />
                </Grid>
            </Border>
            </StackPanel>

            <!-- Backup -->
            <StackPanel Style="{StaticResource Page5}">
            <TextBlock Margin="0,20,0,8" Style="{DynamicResource Text.Label}" Text="BACKUP" />
            <Border Background="{DynamicResource Brush.Card}" CornerRadius="12" Padding="16,12" Margin="0,0,8,0">
                <StackPanel DataContext="{Binding Backup}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="Back up your data" />
                            <TextBlock Margin="0,2,0,0" Style="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                                       Text="Saves your events, checklists, settings and plot layout as one file. Your files and folders are not included." />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top" Style="{DynamicResource Button.Text}" Content="Back up…" Command="{Binding BackUpCommand}" />
                    </Grid>
                    <Border Height="1" Margin="0,12,0,12" Background="{DynamicResource Brush.Rule}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" Text="Restore from a backup" />
                            <TextBlock Margin="0,2,0,0" Style="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                                       Text="Replaces your current events, settings and plots. What you have now is saved first, in the backups folder. Calendar links need adding again on another PC." />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top" Style="{DynamicResource Button.Text}" Content="Restore…" Command="{Binding RestoreCommand}" />
                    </Grid>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal"
                                Visibility="{Binding HasPendingRestore, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{DynamicResource Button.Primary}" Content="Restart now" Command="{Binding RestartNowCommand}" />
                        <Button Margin="4,0,0,0" Style="{DynamicResource Button.Text}" Content="Cancel" Command="{Binding CancelRestoreCommand}" />
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding Status}"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                        <Setter Property="FontWeight" Value="Medium" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            </StackPanel>
            </StackPanel>
            </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
