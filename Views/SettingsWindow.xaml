<Window x:Class="TidyYard.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TidyYard.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Tidy Yard Settings"
        Style="{DynamicResource Style.Window}"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- One ruled row: label column on the left, control on the right. -->
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rule}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Brush.RuleStrong}" BorderThickness="1">
        <StackPanel>
            <!-- Header -->
            <Border Height="48" BorderBrush="{DynamicResource Brush.RuleStrong}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0,8,0">
                    <TextBlock VerticalAlignment="Center" Style="{DynamicResource Text.Title}" Text="Settings" />
                    <Button HorizontalAlignment="Right"
                            Style="{DynamicResource Button.Icon}"
                            Content="{DynamicResource Glyph.Close}"
                            Click="OnCloseClick"
                            ToolTip="Close"
                            AutomationProperties.Name="Close"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </Grid>
            </Border>

            <!-- Theme -->
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,8,0,0" VerticalAlignment="Top" Style="{DynamicResource Text.Label}" Text="Theme" />
                    <ListBox Grid.Column="1"
                             Margin="0,0,0,-4"
                             Style="{DynamicResource ListBox.Options}"
                             ItemsSource="{Binding Themes}"
                             SelectedItem="{Binding SelectedTheme}"
                             DisplayMemberPath="Name"
                             AutomationProperties.Name="Theme" />
                </Grid>
            </Border>

            <!-- Calendar opacity -->
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{DynamicResource Text.Label}" Text="Calendar opacity" />
                    <Slider Grid.Column="1"
                            VerticalAlignment="Center"
                            Minimum="{Binding MinOpacity}"
                            Maximum="{Binding MaxOpacity}"
                            SmallChange="1"
                            LargeChange="5"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding OpacityPercent}"
                            AutomationProperties.Name="Calendar opacity" />
                    <TextBlock Grid.Column="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.Numbers}"
                               Text="{Binding OpacityText}" />
                </Grid>
            </Border>

            <!-- Data folder -->
            <Border Style="{StaticResource Row}" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{DynamicResource Text.Label}" Text="Data folder" />
                    <TextBlock Grid.Column="1"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Style="{DynamicResource Text.Numbers}"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding DataFolder}"
                               ToolTip="{Binding DataFolder}" />
                    <Button Grid.Column="2"
                            Style="{DynamicResource Button.Plain}"
                            Content="Open"
                            Command="{Binding OpenDataFolderCommand}" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
