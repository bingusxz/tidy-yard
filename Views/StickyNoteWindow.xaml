<Window x:Class="TidyYard.Views.StickyNoteWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Sticky note - Tidy Yard" Style="{DynamicResource Style.Window}"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" ShowActivated="False" Width="280" Height="280" MinWidth="240" MinHeight="170" ResizeMode="CanResizeWithGrip">
 <Window.Resources>
  <SolidColorBrush x:Key="Brush.PaperText" Color="#2D2B27" />
  <SolidColorBrush x:Key="Brush.PaperMuted" Color="#4D4941" />
  <SolidColorBrush x:Key="Brush.PaperRule" Color="#69635A" />
  <SolidColorBrush x:Key="Brush.PaperHover" Color="#14000000" />
  <SolidColorBrush x:Key="Brush.PaperPressed" Color="#26000000" />
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource Brush.PaperText}" />
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="FontSize" Value="10" />
   <Setter Property="Padding" Value="2" />
   <Setter Property="Height" Value="28" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="VerticalAlignment" Value="Center" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="PaperButtonBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PaperButtonBorder" Property="Background" Value="{DynamicResource Brush.PaperHover}" /></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="PaperButtonBorder" Property="Background" Value="{DynamicResource Brush.PaperPressed}" /></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PaperButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.PaperText}" /></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <WindowChrome.WindowChrome>
  <WindowChrome CaptionHeight="38" ResizeBorderThickness="5" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
 </WindowChrome.WindowChrome>
 <Grid Margin="6">
  <Border x:Name="BackSheetTwo" Background="#CABC86" Margin="4,6,0,0" CornerRadius="2" IsHitTestVisible="False" />
  <Border x:Name="BackSheetOne" Background="#E3D49B" Margin="2,3,1,2" CornerRadius="2" IsHitTestVisible="False" />
  <Border x:Name="Paper" CornerRadius="2" RenderTransformOrigin="0.5,0.15">
   <Border.Effect><DropShadowEffect BlurRadius="9" ShadowDepth="3" Opacity="0.2" /></Border.Effect>
   <Border.RenderTransform><TransformGroup><RotateTransform x:Name="PaperRotation"/><TranslateTransform x:Name="PaperSlide"/></TransformGroup></Border.RenderTransform>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="16"/></Grid.RowDefinitions>
    <Border x:Name="HeaderBand" Background="#14000000" />
    <DockPanel Margin="8,0,4,0">
     <Button DockPanel.Dock="Right" Width="28" Click="OnTear" ToolTip="Delete note (recoverable from tray)" AutomationProperties.Name="Delete note" WindowChrome.IsHitTestVisibleInChrome="True">
      <Path Width="12" Height="14" Stretch="Uniform" Stroke="{DynamicResource Brush.PaperText}" StrokeThickness="1.5" Data="M3,4 L13,4 M6,4 L6,2 L10,2 L10,4 M4,4 L5,15 L11,15 L12,4 M7,7 L7,12 M9,7 L9,12" />
     </Button>
     <Button DockPanel.Dock="Right" x:Name="PinButton" Width="40" Click="OnPin" WindowChrome.IsHitTestVisibleInChrome="True" />
     <Button DockPanel.Dock="Right" Content="Colour" Width="48" Click="OnColor" ToolTip="Change paper colour" AutomationProperties.Name="Change paper colour" WindowChrome.IsHitTestVisibleInChrome="True" />
     <Button DockPanel.Dock="Right" x:Name="RollButton" Width="26" Click="OnRoll" FontFamily="{DynamicResource Font.Icons}" FontSize="11" WindowChrome.IsHitTestVisibleInChrome="True" />
     <Button DockPanel.Dock="Right" x:Name="LockButton" Width="26" Click="OnLock" FontFamily="{DynamicResource Font.Icons}" FontSize="11" WindowChrome.IsHitTestVisibleInChrome="True" />
     <Grid>
      <TextBlock x:Name="SheetHeading" Text="NOTEPAD" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.PaperMuted}"
        ToolTip="Double-click to rename" MouseLeftButtonDown="OnHeadingClick" WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" />
      <TextBox x:Name="HeadingEditor" Visibility="Collapsed" FontSize="10" VerticalAlignment="Center" MaxLength="40" BorderThickness="0" Padding="0" Background="Transparent"
        Foreground="{DynamicResource Brush.PaperText}" CaretBrush="{DynamicResource Brush.PaperText}" AutomationProperties.Name="Notepad name"
        KeyDown="OnHeadingKey" LostKeyboardFocus="OnHeadingLostFocus" WindowChrome.IsHitTestVisibleInChrome="True" />
     </Grid>
    </DockPanel>
    <Rectangle x:Name="Rules" Grid.Row="1" Margin="14,12,14,4" IsHitTestVisible="False" Opacity="0.12">
     <Rectangle.Fill>
      <DrawingBrush TileMode="Tile" Viewport="0,0,16,26" ViewportUnits="Absolute" Viewbox="0,0,16,26" ViewboxUnits="Absolute">
       <DrawingBrush.Drawing><GeometryDrawing Geometry="M0,25 L16,25"><GeometryDrawing.Pen><Pen Brush="{DynamicResource Brush.PaperRule}" Thickness="0.6" /></GeometryDrawing.Pen></GeometryDrawing></DrawingBrush.Drawing>
      </DrawingBrush>
     </Rectangle.Fill>
    </Rectangle>
    <TextBox x:Name="Editor" Grid.Row="1" Margin="14,12,14,4" Background="Transparent" BorderThickness="0"
      Foreground="{DynamicResource Brush.PaperText}" CaretBrush="{DynamicResource Brush.PaperText}" SelectionBrush="#30333333" FontFamily="Segoe Print, Segoe UI" FontSize="15" VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch" AcceptsReturn="True" AcceptsTab="True"
      TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
      TextChanged="OnTextChanged" AutomationProperties.Name="Note text" WindowChrome.IsHitTestVisibleInChrome="True">
      <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Stretch" VerticalContentAlignment="Top" Padding="0" /></ControlTemplate></TextBox.Template>
    </TextBox>
    <Thumb x:Name="PeelGrip" Grid.Row="1" Grid.RowSpan="2" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="Hand"
      DragStarted="OnPeelStarted" DragDelta="OnPeelDelta" DragCompleted="OnPeelCompleted" ToolTip="Pull this corner to curl and release the sheet, then drag it into place. Escape cancels." AutomationProperties.Name="Peel from bottom right" WindowChrome.IsHitTestVisibleInChrome="True">
     <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Path Fill="{DynamicResource Brush.PaperFold}" Data="M0,36 Q24,34 36,0 L36,36 Z"/><Path Stroke="{DynamicResource Brush.PaperRule}" StrokeThickness="0.7" Data="M0,36 Q24,34 36,0" /></Grid></ControlTemplate></Thumb.Template>
    </Thumb>
    <Thumb x:Name="LeftPeelGrip" Grid.Row="1" Grid.RowSpan="2" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="Hand"
      DragStarted="OnPeelStarted" DragDelta="OnPeelDelta" DragCompleted="OnPeelCompleted" ToolTip="Pull this corner to curl and release the sheet, then drag it into place. Escape cancels." AutomationProperties.Name="Peel from bottom left" WindowChrome.IsHitTestVisibleInChrome="True">
     <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform ScaleX="-1" /></Grid.RenderTransform><Path Fill="{DynamicResource Brush.PaperFold}" Data="M0,36 Q24,34 36,0 L36,36 Z"/><Path Stroke="{DynamicResource Brush.PaperRule}" StrokeThickness="0.7" Data="M0,36 Q24,34 36,0" /></Grid></ControlTemplate></Thumb.Template>
    </Thumb>
   </Grid>
  </Border>
 </Grid>
</Window>
