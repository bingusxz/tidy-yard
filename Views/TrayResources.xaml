<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tb="http://www.hardcodet.net/taskbar">

    <!-- DataContext (TrayViewModel) and Icon are set in App.OnStartup. -->
    <tb:TaskbarIcon x:Key="TrayIcon"
                    x:Shared="False"
                    ToolTipText="Tidy Yard"
                    NoLeftClickDelay="True"
                    MenuActivation="RightClick"
                    LeftClickCommand="{Binding OpenCalendarCommand}">
        <tb:TaskbarIcon.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Open Calendar" Command="{Binding OpenCalendarCommand}" />
                <Separator />
                <MenuItem Header="New plot" Command="{Binding NewFenceCommand}" />
                <MenuItem Header="Plot from folder…" Command="{Binding NewFenceFromFolderCommand}" />
                <MenuItem Header="Bring unlocked plots to front (Win+Alt+F)" Command="{Binding BringFencesToFrontCommand}" />
                <MenuItem Header="Lock all plots" Command="{Binding LockAllFencesCommand}" />
                <MenuItem Header="Unlock all plots" Command="{Binding UnlockAllFencesCommand}" />
                <MenuItem Header="Tidy desktop…" Command="{Binding TidyDesktopCommand}" />
                <MenuItem Header="{Binding UndoText}" Command="{Binding UndoLastMoveCommand}" />
                <Separator />
                <MenuItem Header="Settings" Command="{Binding OpenSettingsCommand}" />
                <Separator />
                <MenuItem Header="Quit" Command="{Binding QuitCommand}" />
            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>

</ResourceDictionary>
