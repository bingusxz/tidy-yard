<Window x:Class="TidyYard.Views.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TidyYard.ViewModels"
        xmlns:views="clr-namespace:TidyYard.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FenceViewModel}"
        Title="{Binding Title}"
        Style="{DynamicResource Style.Window}"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Width="360" Height="280"
        MinWidth="96" MinHeight="44"
        AllowDrop="True"
        MouseRightButtonUp="OnWindowRightClick"
        ContextMenuOpening="OnContextMenuOpening"
        ContextMenuClosing="OnContextMenuClosing"
        DragEnter="OnDragOver"
        DragOver="OnDragOver"
        DragLeave="OnDragLeave"
        Drop="OnDrop">

    <!-- Drag by the title bar, resize from the edges. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- Tint: the theme glass, or this fence's own colour. -->
        <!-- A see-through window passes clicks to whatever is behind it. This near-invisible layer keeps the plot clickable. -->
        <Border Background="{DynamicResource Brush.HitArea}" CornerRadius="{Binding FlatCornerRadius}" />

        <Border Opacity="{Binding TintOpacity}" CornerRadius="{Binding FlatCornerRadius}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Brush.Glass}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasCustomTint}" Value="True">
                            <Setter Property="Background" Value="{Binding TintBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Shown while files are dragged over the fence. -->
        <Border x:Name="DropHighlight" CornerRadius="{Binding FlatCornerRadius}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="2" Background="{DynamicResource Brush.AccentSoft}" Visibility="Collapsed" IsHitTestVisible="False" />

        <DockPanel>
            <!-- Title bar -->
            <Grid DockPanel.Dock="Top" Height="44" Margin="14,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           HorizontalAlignment="{Binding TitleHorizontalAlignment}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Title}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <!-- Rolled up: just the name, centred. -->
                                <DataTrigger Binding="{Binding ShowControls}" Value="False">
                                    <Setter Property="Margin" Value="0,0,8,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasCustomTitleColor}" Value="True">
                                    <Setter Property="Foreground" Value="{Binding TitleBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasCustomTitleFont}" Value="True">
                                    <Setter Property="FontFamily" Value="{Binding TitleFontFamily}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasCustomTitleSize}" Value="True">
                                    <Setter Property="FontSize" Value="{Binding TitleTextSize}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBox x:Name="RenameBox"
                         VerticalAlignment="Center"
                         Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                         IsVisibleChanged="OnRenameBoxVisibleChanged"
                         LostKeyboardFocus="OnRenameBoxLostFocus"
                         AutomationProperties.Name="Plot name"
                         WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding CommitRenameCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <TextBlock Grid.Column="1"
                           Margin="8,0,4,0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource Size.Small}"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Visibility="{Binding ShowControls, Converter={StaticResource BoolToVisibility}}"
                           Text="{Binding CountText}" />

                <!-- Lock state at a glance; one click to change it. -->
                <Button Grid.Column="2"
                        Command="{Binding ToggleLockCommand}"
                        ToolTip="{Binding LockToolTip}"
                        AutomationProperties.Name="{Binding LockToolTip}"
                        Visibility="{Binding ShowControls, Converter={StaticResource BoolToVisibility}}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                            <Setter Property="Content" Value="{DynamicResource Glyph.Unlock}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                    <Setter Property="Content" Value="{DynamicResource Glyph.Lock}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="3"
                        Command="{Binding ToggleRollUpCommand}"
                        Visibility="{Binding ShowControls, Converter={StaticResource BoolToVisibility}}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                            <Setter Property="Content" Value="{DynamicResource Glyph.ChevronUp}" />
                            <Setter Property="ToolTip" Value="Roll up" />
                            <Setter Property="AutomationProperties.Name" Value="Roll up" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRolledUp}" Value="True">
                                    <Setter Property="Content" Value="{DynamicResource Glyph.ChevronDown}" />
                                    <Setter Property="ToolTip" Value="Roll down" />
                                    <Setter Property="AutomationProperties.Name" Value="Roll down" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Rolled up: hidden and zero-width, but still the anchor the colour and text panels open from. -->
                <Button x:Name="MenuButton"
                        Grid.Column="4"
                        Content="{DynamicResource Glyph.More}"
                        Click="OnMenuClick"
                        ToolTip="Plot options"
                        AutomationProperties.Name="Plot options"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowControls}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{Binding CountText}" IsEnabled="False" Visibility="{Binding HasCount, Converter={StaticResource BoolToVisibility}}" />
                            <MenuItem Header="{Binding RollUpMenuText}" Command="{Binding ToggleRollUpCommand}" />
                            <MenuItem Header="Rename" Command="{Binding BeginRenameCommand}" />
                            <Separator />
                            <MenuItem Header="Folder">
                                <MenuItem Header="Open folder" Command="{Binding OpenFolderCommand}" />
                                <MenuItem Header="Change folder…" Command="{Binding ChangeFolderCommand}" />
                            </MenuItem>
                            <MenuItem Header="Tabs">
                                <MenuItem Header="New tab" Command="{Binding NewTabCommand}" />
                                <MenuItem Header="Tab from folder…" Command="{Binding NewTabFromFolderCommand}" />
                                <MenuItem Header="Rename tab"
                                          Command="{Binding BeginRenameTabCommand}"
                                          CommandParameter="{Binding SelectedTab}"
                                          Visibility="{Binding HasTabBar, Converter={StaticResource BoolToVisibility}}" />
                                <MenuItem Header="Remove tab (keeps the folder)"
                                          Command="{Binding RemoveTabCommand}"
                                          CommandParameter="{Binding SelectedTab}"
                                          Visibility="{Binding HasTabBar, Converter={StaticResource BoolToVisibility}}" />
                            </MenuItem>
                            <MenuItem Header="Add shortcut">
                                <MenuItem Header="Recycle Bin" Command="{Binding AddShortcutCommand}" CommandParameter="recyclebin" />
                                <MenuItem Header="This PC" Command="{Binding AddShortcutCommand}" CommandParameter="thispc" />
                            </MenuItem>
                            <MenuItem Header="Look">
                                <MenuItem Header="Colour and corners…" Command="{Binding PickColorCommand}" />
                                <MenuItem Header="Text…" Command="{Binding PickTextCommand}" />
                                <MenuItem Header="Reset colour" Command="{Binding ResetColorCommand}" Visibility="{Binding HasCustomTint, Converter={StaticResource BoolToVisibility}}" />
                                <Separator />
                                <MenuItem Header="Grid layout" Command="{Binding SetLayoutCommand}" CommandParameter="Grid" IsChecked="{Binding IsGridLayout, Mode=OneWay}" />
                                <MenuItem Header="Row layout" Command="{Binding SetLayoutCommand}" CommandParameter="Row" IsChecked="{Binding IsRowLayout, Mode=OneWay}" />
                                <MenuItem Header="List layout" Command="{Binding SetLayoutCommand}" CommandParameter="List" IsChecked="{Binding IsListLayout, Mode=OneWay}" />
                            </MenuItem>
                            <MenuItem Header="Behaviour">
                                <MenuItem Header="Open on hover when rolled up" Command="{Binding TogglePeekOnHoverCommand}" IsChecked="{Binding PeekOnHover, Mode=OneWay}" />
                                <MenuItem Header="Fit height to contents" Command="{Binding ToggleFitHeightCommand}" IsChecked="{Binding FitHeight, Mode=OneWay}" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{Binding LockMenuText}" Command="{Binding ToggleLockCommand}" />
                            <MenuItem Header="Remove plot (keeps the folder)" Command="{Binding RemoveCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Popup Grid.Column="4"
                       IsOpen="{Binding IsColorPickerOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=MenuButton}"
                       Placement="Bottom"
                       HorizontalOffset="-232"
                       StaysOpen="True"
                       AllowsTransparency="True">
                    <Border Margin="0,8,0,0" Padding="16" CornerRadius="12"
                            Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.RuleStrong}" BorderThickness="1"
                            TextElement.Foreground="{DynamicResource Brush.Text}" TextElement.FontFamily="{DynamicResource Font.UI}">
                        <StackPanel Width="232">
                            <!-- Drag the title to move the panel; it stays open until closed. -->
                            <Grid Margin="0,-4,0,8">
                                <Thumb Height="28" Cursor="SizeAll" DragDelta="OnPanelDrag">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <TextBlock VerticalAlignment="Center" IsHitTestVisible="False" Style="{DynamicResource Text.Label}" Text="Plot colour" />
                                <Button Width="28" Height="28" HorizontalAlignment="Right"
                                        Style="{DynamicResource Button.Icon}" Content="{DynamicResource Glyph.Close}"
                                        Command="{Binding ClosePanelsCommand}"
                                        ToolTip="Close" AutomationProperties.Name="Close" />
                            </Grid>
                            <views:ColorPicker SelectedColor="{Binding TintColor}" Presets="{Binding DataContext.TintPresets, RelativeSource={RelativeSource AncestorType=Window}}" />

                            <!-- Glass: three stops, the only sizes Windows can round it to. Flat: any size from 0 to 24. -->
                            <DockPanel Margin="0,16,0,0">
                                <TextBlock DockPanel.Dock="Right"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           Text="{Binding CornerName}" />
                                <TextBlock Style="{DynamicResource Text.Label}" Text="Corners" />
                            </DockPanel>
                            <Slider Margin="0,4,0,0"
                                    Minimum="0" Maximum="{Binding CornerMax}"
                                    SmallChange="{Binding CornerStep}" LargeChange="{Binding CornerStep}"
                                    TickFrequency="{Binding CornerStep}" IsSnapToTickEnabled="True"
                                    Value="{Binding CornerSize}"
                                    AutomationProperties.Name="Corners" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="Glass can only be square, soft or round. Turn on Flat style to drag to any size.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFlat}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock FontWeight="Medium" Text="Flat style" />
                                    <TextBlock Style="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                                               Text="No blur, but any corner size. The plot reopens; open this panel again." />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Style="{DynamicResource CheckBox.Switch}"
                                          IsChecked="{Binding IsFlat, Mode=OneWay}"
                                          Command="{Binding ToggleFlatCommand}"
                                          AutomationProperties.Name="Flat style" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Text: font, size and colour of the title and item names. -->
                <Popup Grid.Column="4"
                       Opened="OnTextPopupOpened"
                       IsOpen="{Binding IsTextPopupOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=MenuButton}"
                       Placement="Bottom"
                       HorizontalOffset="-232"
                       StaysOpen="True"
                       AllowsTransparency="True">
                    <Border Margin="0,8,0,0" Padding="16" CornerRadius="12"
                            Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.RuleStrong}" BorderThickness="1"
                            TextElement.Foreground="{DynamicResource Brush.Text}" TextElement.FontFamily="{DynamicResource Font.UI}">
                        <StackPanel Width="232">
                            <!-- Drag the title to move the panel; it stays open until closed. -->
                            <Grid Margin="0,-4,0,8">
                                <Thumb Height="28" Cursor="SizeAll" DragDelta="OnPanelDrag">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <TextBlock VerticalAlignment="Center" IsHitTestVisible="False" Style="{DynamicResource Text.Label}" Text="Text" />
                                <Button Width="28" Height="28" HorizontalAlignment="Right"
                                        Style="{DynamicResource Button.Icon}" Content="{DynamicResource Glyph.Close}"
                                        Command="{Binding ClosePanelsCommand}"
                                        ToolTip="Close" AutomationProperties.Name="Close" />
                            </Grid>

                            <!-- What the options below change: the title, or the file names. -->
                            <ListBox HorizontalAlignment="Stretch"
                                     Style="{DynamicResource ListBox.Segmented}"
                                     ItemsSource="{Binding TextTargets}"
                                     SelectedItem="{Binding SelectedTextTarget}"
                                     AutomationProperties.Name="Change text of">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center" Text="{Binding}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Visibility="{Binding EditingHeader, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Margin="0,12,0,0" Style="{DynamicResource Text.Label}" Text="Title position" />
                                <ListBox HorizontalAlignment="Stretch"
                                         Margin="0,4,0,0"
                                         Style="{DynamicResource ListBox.Segmented}"
                                         ItemsSource="{Binding TitleAlignments}"
                                         SelectedItem="{Binding TitleAlign}"
                                         AutomationProperties.Name="Title position">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" Text="{Binding}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <TextBlock Margin="0,12,0,0" Style="{DynamicResource Text.Label}" Text="Font" />
                            <TextBox Margin="0,4,0,0"
                                     Tag="Search fonts"
                                     Text="{Binding FontSearch, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Search fonts" />
                            <ListBox x:Name="FontList"
                                     Height="148"
                                     Margin="0,4,0,0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemsSource="{Binding FontView}"
                                     SelectedItem="{Binding SelectedFont}"
                                     AutomationProperties.Name="Font">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Height="28" Padding="8,0" CornerRadius="8" Background="Transparent">
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- One live preview of the chosen font, instead of drawing every name in its own font. -->
                            <Border Margin="0,6,0,0" Padding="10,8" CornerRadius="8" Background="{DynamicResource Brush.Surface}">
                                <TextBlock Text="Costing Files, 12 Nov" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPreviewFont}" Value="True">
                                                    <Setter Property="FontFamily" Value="{Binding PreviewFontFamily}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <TextBlock Margin="0,12,0,0" Style="{DynamicResource Text.Label}" Text="Size" />
                            <Slider Margin="0,4,0,0"
                                    Minimum="10" Maximum="24"
                                    SmallChange="1" LargeChange="2"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding EditorTextSize}"
                                    AutomationProperties.Name="Text size" />

                            <TextBlock Margin="0,12,0,8" Style="{DynamicResource Text.Label}" Text="Colour" />
                            <views:ColorPicker SelectedColor="{Binding TextColor}" Presets="{Binding DataContext.TextPresets, RelativeSource={RelativeSource AncestorType=Window}}" />

                            <Button Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource Button.Text}"
                                    Content="{Binding ResetTextLabel}"
                                    Command="{Binding ResetTextCommand}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <Border DockPanel.Dock="Top" Height="1" Margin="14,0" Background="{DynamicResource Brush.Rule}" />

            <!-- Tabs: only when the fence has more than one. Each tab is a folder. Drop files on a tab to move them in. -->
            <Grid DockPanel.Dock="Top"
                  Margin="10,6,10,0"
                  Visibility="{Binding HasTabBar, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="TabList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding SelectedTab}"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="OnTabMouseDown"
                         PreviewMouseMove="OnTabMouseMove"
                         PreviewMouseLeftButtonUp="OnTabMouseUp"
                         DragOver="OnTabDragOver"
                         Drop="OnTabDrop"
                         AutomationProperties.Name="Tabs"
                         WindowChrome.IsHitTestVisibleInChrome="True">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                            <Setter Property="FontWeight" Value="Medium" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Margin" Value="0,0,2,0" />
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <EventSetter Event="MouseDoubleClick" Handler="OnTabDoubleClick" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Rename"
                                                  Command="{Binding PlacementTarget.Tag.BeginRenameTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Remove tab (keeps the folder)"
                                                  Command="{Binding PlacementTarget.Tag.RemoveTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Height="26" MinWidth="48" Padding="12,0" CornerRadius="8" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Raised}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FenceTabViewModel}">
                            <Grid>
                                <TextBlock Text="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox MinWidth="72"
                                         Style="{DynamicResource TextBox.Inline}"
                                         Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                         IsVisibleChanged="OnTabEditVisibleChanged"
                                         LostKeyboardFocus="OnTabEditLostFocus"
                                         AutomationProperties.Name="Tab name">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding DataContext.CommitRenameTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        <KeyBinding Key="Escape"
                                                    Command="{Binding DataContext.CancelRenameTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Column="1"
                        Width="26" Height="26"
                        Margin="4,0,0,0"
                        Style="{DynamicResource Button.Icon}"
                        Content="{DynamicResource Glyph.Add}"
                        Command="{Binding NewTabCommand}"
                        ToolTip="New tab"
                        AutomationProperties.Name="New tab"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>

            <!-- Inside a folder: back button and where you are. -->
            <Grid DockPanel.Dock="Top"
                  Margin="10,4,14,0"
                  Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Button Width="28" Height="28"
                            Style="{DynamicResource Button.Icon}"
                            Content="{DynamicResource Glyph.ChevronLeft}"
                            Command="{Binding GoBackCommand}"
                            ToolTip="Back"
                            AutomationProperties.Name="Back"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <TextBlock Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="Medium"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding LocationText}" />
                </StackPanel>
            </Grid>

            <TextBlock DockPanel.Dock="Bottom"
                       Margin="14,4,14,10"
                       Style="{DynamicResource Text.Muted}"
                       Foreground="{DynamicResource Brush.Accent}"
                       Text="{Binding Notice}"
                       Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />

            <!-- Contents -->
            <Grid>
                <TextBlock Margin="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Style="{DynamicResource Text.Muted}"
                           Text="{Binding Message}"
                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />

                <!-- Items. Layout (Grid / Row / List) swaps the panel, the item look and the scroll direction. -->
                <ScrollViewer Padding="6" Focusable="False">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRowLayout}" Value="True">
                                    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                                    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                        <ItemsControl.Resources>
                            <!-- Shared item behaviour: double-click opens, drag out, right-click menu. -->
                            <Style x:Key="FenceItem" TargetType="Button" BasedOn="{StaticResource Button.Bare}">
                                <Setter Property="ToolTip" Value="{Binding Path}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnItemMouseDown" />
                                <EventSetter Event="PreviewMouseMove" Handler="OnItemMouseMove" />
                                <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
                                <!-- Folders accept drops: files dropped on one move into it. -->
                                <Setter Property="AllowDrop" Value="True" />
                                <EventSetter Event="DragOver" Handler="OnItemDragOver" />
                                <EventSetter Event="DragLeave" Handler="OnItemDragLeave" />
                                <EventSetter Event="Drop" Handler="OnItemDrop" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Open"
                                                      Command="{Binding PlacementTarget.Tag.OpenItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Show in folder"
                                                      Command="{Binding PlacementTarget.Tag.ShowItemInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <!-- Item names use the fence's own colour, font and size once any of them has been chosen. -->
                            <Style x:Key="FenceLabelBase" TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.HasCustomTextColor, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.HasCustomFont, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="FontFamily" Value="{Binding DataContext.TextFontFamily, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="FenceTileLabel" TargetType="TextBlock" BasedOn="{StaticResource FenceLabelBase}">
                                <Setter Property="FontSize" Value="{DynamicResource Size.Small}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.HasCustomTextSize, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="FontSize" Value="{Binding DataContext.ItemTextSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="FenceListLabel" TargetType="TextBlock" BasedOn="{StaticResource FenceLabelBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.HasCustomTextSize, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="FontSize" Value="{Binding DataContext.ListLabelSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <!-- Grid and Row: icon above a two-line name. -->
                            <DataTemplate x:Key="TileItem" DataType="{x:Type vm:FenceItemViewModel}">
                                <Button Width="{Binding DataContext.ItemWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Padding="4,8,4,4"
                                        VerticalContentAlignment="Top"
                                        Style="{StaticResource FenceItem}">
                                    <StackPanel>
                                        <Image Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Source="{Binding Icon}"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Margin="0,6,0,0"
                                                   MaxHeight="{Binding DataContext.LabelMaxHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Style="{StaticResource FenceTileLabel}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Name}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>

                            <!-- List: small icon and name on one line. -->
                            <DataTemplate x:Key="ListItem" DataType="{x:Type vm:FenceItemViewModel}">
                                <Button Padding="8,4" HorizontalContentAlignment="Stretch" Style="{StaticResource FenceItem}">
                                    <DockPanel>
                                        <Image DockPanel.Dock="Left" Width="24" Height="24" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource FenceListLabel}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.Resources>

                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="ItemTemplate" Value="{StaticResource TileItem}" />
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRowLayout}" Value="True">
                                        <Setter Property="ItemsPanel">
                                            <Setter.Value>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsListLayout}" Value="True">
                                        <Setter Property="ItemTemplate" Value="{StaticResource ListItem}" />
                                        <Setter Property="ItemsPanel">
                                            <Setter.Value>
                                                <ItemsPanelTemplate>
                                                    <StackPanel />
                                                </ItemsPanelTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
